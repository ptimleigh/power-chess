@* Pixel-art chess pieces: 32x32 shaded sprites drawn as crisp SVG rects (see Game/Sprites.cs). Colours come from fighter.css. *@
@using ChessFighter.Web.Game
<svg viewBox="0 0 32 32" class="piece-svg @(Side == Side.White ? "w" : "b")" shape-rendering="crispEdges" aria-hidden="true">@((MarkupString)Sprites.Body(Type))</svg>

@code {
    [Parameter] public PieceType Type { get; set; }
    [Parameter] public Side Side { get; set; }
}
