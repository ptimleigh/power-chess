@* Pixel-art chess pieces drawn as crisp SVG rects. The full-colour art (Game/Sprites.Art.cs) is used when present; the old shared-palette 32x32 sprites are the fallback (Game/Sprites.cs). *@
@using ChessFighter.Web.Game
@if (Sprites.HasArt)
{
    <img class="piece-svg art @(Side == Side.White ? "w" : "b")" src="img/pieces/@(Side == Side.White ? "white" : "black")_@(Type.ToString().ToLowerInvariant()).png" alt="" draggable="false" />
}
else
{
    <svg viewBox="0 0 32 32" class="piece-svg @(Side == Side.White ? "w" : "b")" shape-rendering="crispEdges" aria-hidden="true">@((MarkupString)Sprites.Body(Type))</svg>
}

@code {
    [Parameter] public PieceType Type { get; set; }
    [Parameter] public Side Side { get; set; }
}
