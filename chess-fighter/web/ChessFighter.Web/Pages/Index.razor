@code {
    GameOptions opt = new();
    bool urlSeed;
    bool muted;
    bool showHelp;
    bool showNew, showMoreOptions;
    bool showProfile;
    bool showDaily;
    bool shared;
    int today;
    MatchReward? puzzleReward;
    bool showDebug;
    Profile profile = new();
    MatchReward? reward;
    int EffectiveLevel => opt.Level < 0 ? Progression.MaxLevel : opt.Level;

    static int XpPercent(Profile p)
    {
        if (p.Level >= Progression.MaxLevel) return 100;
        int lo = Progression.XpForLevel(p.Level), hi = Progression.XpForLevel(p.Level + 1);
        return Math.Clamp((p.Xp - lo) * 100 / Math.Max(1, hi - lo), 0, 100);
    }

    string NextUnlockText
    {
        get
        {
            if (profile.Level >= Progression.MaxLevel) return "Max level. Everything is unlocked.";
            int next = profile.Level + 1;
            var names = Unlocks.AtLevel(next).Select(i => i.Type == UnlockType.Powerup ? Names.Name(i.Kind) : i.Type == UnlockType.Cards ? string.Join(" / ", i.CardKinds.Select(Names.CardShort)) + " cards" : i.Name).ToList();
            return $"{Progression.XpForLevel(next) - profile.Xp} XP to level {next}" + (names.Count > 0 ? ": unlocks " + string.Join(", ", names) : "");
        }
    }

    async Task RefreshToday()
    {
        if (opt.Day is int forced) { if (today < forced) today = forced; return; }
        try { today = await JS.InvokeAsync<int>("pcfx.today"); }
        catch { today = Daily.DayNumber(DateTime.Now); }
    }

    async Task OpenDaily()
    {
        await RefreshToday();
        showDaily = true;
    }

    void WireSession()
    {
        S.Changed = () => InvokeAsync(StateHasChanged);
        S.TutorialsChanged = text => { _ = SetItemAsync(TutKey, text); };
        S.Sfx = name => { _ = PlaySfx(name); };
        S.GameEnded = OnGameEnded;
        S.PuzzleSolved = OnPuzzleSolved;
    }

    void StartPuzzle()
    {
        showDaily = false;
        shared = false;
        puzzleReward = null;
        var def = Daily.PuzzleFor(today);
        var popt = new GameOptions { Ai = 2, Puzzle = def, Seed = (ulong)DateTime.UtcNow.Ticks, Tutorials = opt.Tutorials, Drama = opt.Drama, Mode = opt.Mode, Level = -1 };
        if (S != null) { S.Changed = null; S.Sfx = null; S.Persist = null; }
        S = new GameSession(popt, tut);
        WireSession();
        reward = null;
    }

    void RetryPuzzle()
    {
        if (S.Puzzle != null) StartPuzzle();
    }

    async Task QuitPuzzle()
    {
        puzzleReward = null;
        StartNew(persist: false);
        string? saved = null;
        if (!debugOptions)
        {
            try { saved = await JS.InvokeAsync<string?>("localStorage.getItem", SaveKey); } catch { }
        }
        bool restored = !string.IsNullOrEmpty(saved) && S.Restore(saved);
        if (!debugOptions) EnablePersist();
        if (restored) await S.ResumeAi();
    }

    void OnPuzzleSolved(PuzzleDef def, int moves)
    {
        int levelBefore = profile.Level;
        puzzleReward = Daily.AwardSolve(profile, today);
        _ = SetItemAsync(ProfileKey, ProfileCodec.Encode(profile));
        puzzleMoves = moves;
        if (puzzleReward != null && puzzleReward.NewLevel > puzzleReward.OldLevel)
        {
            // a level-up from the daily: spotlight what it unlocked, once the solved card is up
            newUnlocks = Unlocks.Between(puzzleReward.OldLevel, puzzleReward.NewLevel);
            if (newUnlocks.Count > 0) { unseenUnlocks = true; _ = SpotlightSoon(); }
        }
    }

    async Task SpotlightSoon()
    {
        // wait for the solved card to be on screen, then give it a moment before the spotlight covers it
        for (int i = 0; i < 100 && !(S.PuzzleOutcome != PuzzleResult.None && !S.Busy); i++) await Task.Delay(100);
        await Task.Delay(1500);
        if (newUnlocks.Count > 0 && S.Puzzle != null) { spotlightOpen = true; StateHasChanged(); }
    }
    int puzzleMoves;

    /// <summary>Opens the replay of the solved puzzle and starts making the video to share, like a normal replay.</summary>
    async Task SharePuzzle()
    {
        var def = Daily.PuzzleFor(today);
        clipOngoing = false;
        clipHistory = S.History;
        clipAvail = ClipBuilder.Available(clipHistory);
        if (clipAvail == 0) return;
        clipPlies = clipAvail;
        clipTitle = "DAILY: " + def.Title.ToUpperInvariant();
        clipMsg = "";
        showClip = true;
        clipReady = false;
        StateHasChanged();
        await Task.Delay(80);
        await RenderClip();
    }

    void OnGameEnded(MatchSummary m)
    {
        if ((debugOptions && !opt.Rewards) || !S.Rewardable) { reward = null; return; }
        int xpBefore = profile.Xp;
        reward = Progression.Award(profile, m);
        RefreshUnlocks();
        opt.Level = profile.Level;
        _ = SetItemAsync(ProfileKey, ProfileCodec.Encode(profile));
        _ = RunXpAnim(xpBefore, profile.Xp);
    }

    // ---------- XP bar fill after a win ----------

    bool xpAnimDone = true, animSnap, showXpDetail;
    int animPct, animLevel;
    int xpAnimSerial;

    static int PctIn(int xp, int level)
    {
        if (level >= Progression.MaxLevel) return 100;
        int lo = Progression.XpForLevel(level), hi = Progression.XpForLevel(level + 1);
        return Math.Clamp((xp - lo) * 100 / Math.Max(1, hi - lo), 0, 100);
    }

    /// <summary>Fills the bar from where it was to where it is now. A level-up fills it to the top, flashes, empties and carries on.</summary>
    async Task RunXpAnim(int xpBefore, int xpAfter)
    {
        int serial = ++xpAnimSerial;
        int from = Progression.LevelForXp(xpBefore), to = Progression.LevelForXp(xpAfter);
        xpAnimDone = false;
        animLevel = from;
        animPct = PctIn(xpBefore, from);
        StateHasChanged();
        await Task.Delay(700);
        for (int lvl = from; lvl <= to; lvl++)
        {
            if (serial != xpAnimSerial) return;
            animLevel = lvl;
            animPct = lvl == to ? PctIn(xpAfter, lvl) : 100;
            StateHasChanged();
            await Task.Delay(1000);
            if (lvl < to)
            {
                animLevel = lvl + 1;
                animSnap = true;
                animPct = 0;
                StateHasChanged();
                await Task.Delay(120);
                animSnap = false;
                StateHasChanged();
                await Task.Delay(120);
            }
        }
        if (serial != xpAnimSerial) return;
        xpAnimDone = true;
        StateHasChanged();
        // a level-up: spotlight everything earned, one card at a time
        if (newUnlocks.Count > 0)
        {
            await Task.Delay(900);
            if (serial == xpAnimSerial) { spotlightOpen = true; StateHasChanged(); }
        }
    }
    bool spotlightOpen;

    void DebugXp(int xp, bool reset = false)
    {
        if (reset) profile = new Profile(); else profile.Xp = xp;
        opt.Level = debugOptions && opt.Level >= 0 && !reset ? opt.Level : profile.Level;
        _ = SetItemAsync(ProfileKey, ProfileCodec.Encode(profile));
    }
    const string ProfileKey = "chessfighter.profile.v1";
    int logoTaps;
    DateTime lastLogoTap;

    /// <summary>Banked moves and Armor to put on a piece; the second number is how many times to apply it (2 = tier II).</summary>
    static readonly (string Label, PowerupKind Kind, int Times)[] DebugBuffs =
    {
        ("Fireball I", PowerupKind.Fireball, 1), ("Fireball II", PowerupKind.Fireball, 2),
        ("Checkers I", PowerupKind.Leap, 1), ("Checkers II", PowerupKind.Leap, 2), ("Checkers III", PowerupKind.Leap, 3),
        ("Bomb I", PowerupKind.SmallBomb, 1), ("Bomb II", PowerupKind.SmallBomb, 2),
        ("Poison", PowerupKind.Poison, 1), ("Ghost", PowerupKind.Ghost, 1), ("Armor", PowerupKind.SpikedArmor, 1),
    };

    /// <summary>Every kind of powerup square the pool can hand out.</summary>
    static readonly PowerupKind[] DebugSquares =
    {
        PowerupKind.Fireball, PowerupKind.Leap, PowerupKind.SmallBomb, PowerupKind.Poison, PowerupKind.Ghost,
        PowerupKind.Combo2, PowerupKind.Combo4, PowerupKind.StunBolt, PowerupKind.StealGrab, PowerupKind.DrawCard, PowerupKind.SpikedArmor,
    };

    /// <summary>Tap the logo five times to open the debug tools (or start with ?debug=1).</summary>
    void LogoTap()
    {
        var now = DateTime.UtcNow;
        logoTaps = (now - lastLogoTap).TotalMilliseconds < 1500 ? logoTaps + 1 : 1;
        lastLogoTap = now;
        if (logoTaps >= 5) { logoTaps = 0; showDebug = !showDebug; if (!showDebug) S.DebugDisarm(); }
    }

    /// <summary>Start (or stop) a game where the AI plays both sides. Nothing on the board says so.</summary>
    void ToggleWatch()
    {
        opt.Watch = !opt.Watch;
        if (opt.Watch) { if (opt.Ai <= 0) opt.Ai = 6; StartNew(persist: false); }
        else StartNew();
        showDebug = false;
    }

    void CloseDebug()
    {
        showDebug = false;
        S.DebugDisarm();
    }
    SquareMode selMode = SquareMode.Revealed;
    int selAi = 2;
    string selPlayAs = "white";
    bool selDrama = true;
    const string SettingsKey = "chessfighter.settings.v2";
    const string OldSettingsKey = "chessfighter.settings.v1";
    GameSession S = null!;

    record PerkBtn(PowerupKind Kind, ActionKind Action, string Label, string Tip);

    static readonly PerkBtn[] ChipKinds =
    {
        new(PowerupKind.Steal, ActionKind.Steal, "Steal", "Steals"),
        new(PowerupKind.Stun, ActionKind.Stun, "Stun", "Stuns"),
        new(PowerupKind.Boulder, ActionKind.PlaceBoulder, "Boulder", "Boulders"),
        new(PowerupKind.Swap, ActionKind.Swap, "Swap", "Swaps: trade two of your pieces"),
        new(PowerupKind.Reroll, ActionKind.ClearBoulder, "Smash boulder", "Rerolls: re-draw a powerup you find, or smash a boulder"),
        new(PowerupKind.Rewind, ActionKind.Move, "Rewind", "Rewinds: take back your last turn"),
    };

    static readonly PerkBtn[] PerkButtons =
    {
        new(PowerupKind.Steal, ActionKind.Steal, "Steal", "Steals"),
        new(PowerupKind.Stun, ActionKind.Stun, "Stun", "Stuns"),
        new(PowerupKind.Boulder, ActionKind.PlaceBoulder, "Boulder", "Boulders"),
        new(PowerupKind.Swap, ActionKind.Swap, "Swap", "Swaps: trade two of your pieces"),
        new(PowerupKind.Reroll, ActionKind.ClearBoulder, "Smash boulder", "Rerolls: re-draw a powerup you find, or smash a boulder"),
    };

    /// <summary>The side whose inventory the action bar shows (the human, or whoever is to move in 2-player mode).</summary>
    Side ActiveSide => S.VsAi ? S.HumanSide : S.Turn;

    const string SaveKey = "chessfighter.save.v1";
    const string TutKey = "chessfighter.tutorials.v1";
    const string PlayedKey = "chessfighter.played.v1";
    bool debugOptions;
    readonly TutorialState tut = new();

    protected override async Task OnInitializedAsync()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        opt = GameOptions.FromQuery(uri.Query);
        urlSeed = uri.Query.Contains("seed=", StringComparison.OrdinalIgnoreCase);
        // Any explicit scenario option (seed, fen, perks, ...) means "start exactly this": no resuming, no saving.
        showDebug = uri.Query.Contains("debug=1", StringComparison.OrdinalIgnoreCase);
        debugOptions = new[] { "seed=", "fen=", "pairs=", "spawn=", "rerolls=", "only=", "perks=", "buffs=", "cards=", "pending=", "scramble=", "mystery=", "demo=", "training=", "mode=", "hidden=", "reveal=", "portal=", "portals=", "drama=", "level=", "preset=", "freq=", "custom=", "watch=" }
            .Any(k => uri.Query.Contains(k, StringComparison.OrdinalIgnoreCase));

        // A session must exist for the first render. It does not save yet, so it cannot overwrite the stored game
        // before we have read it.
        if (debugOptions && !opt.TutorialsExplicit) opt.Tutorials = false;
        StartNew(persist: false);

        string? saved = null, played = null, tutText = null, settingsText = null, profileText = null;
        try
        {
            tutText = await JS.InvokeAsync<string?>("localStorage.getItem", TutKey);
            profileText = await JS.InvokeAsync<string?>("localStorage.getItem", ProfileKey);
            if (!debugOptions)
            {
                saved = await JS.InvokeAsync<string?>("localStorage.getItem", SaveKey);
                played = await JS.InvokeAsync<string?>("localStorage.getItem", PlayedKey);
                settingsText = await JS.InvokeAsync<string?>("localStorage.getItem", SettingsKey);
                if (settingsText == null)
                {
                    // Settings saved before the opponent list changed: "Normal" (2) is now called Hard, so move those players to the new, easier Normal (6).
                    var oldText = await JS.InvokeAsync<string?>("localStorage.getItem", OldSettingsKey);
                    if (!string.IsNullOrEmpty(oldText))
                    {
                        var parts = oldText.Split(':');
                        if (parts.Length >= 2 && parts[1] == "2") { parts[1] = "6"; oldText = string.Join(":", parts); }
                        settingsText = oldText;
                    }
                }
            }
        }
        catch { /* storage unavailable: just play */ }

        profile = ProfileCodec.Decode(profileText);
        await RefreshToday();
        if (!debugOptions) opt.Level = profile.Level;
        var stored = TutorialState.Parse(tutText);
        tut.Off = stored.Off;
        tut.Seen.Clear();
        foreach (var k in stored.Seen) tut.Seen.Add(k);

        adsAvailable = await Ads.IsAvailableAsync();
        if (opt.Demo is PowerupKind demo) S.ShowTutorial(demo);
        if (debugOptions) return;

        // Remembered choices from the New game sheet (mode and opponent).
        bool haveSettings = false;
        var sp = (settingsText ?? "").Split(':');
        if (sp.Length >= 2 && sp.Length <= 7 && int.TryParse(sp[1], out var savedAi) && savedAi >= 0 && savedAi <= 6)
        {
            if (sp.Length >= 3) opt.Drama = sp[2] != "0";
            if (sp.Length >= 5)
            {
                opt.Preset = sp[3] == Presets.Custom || Presets.Find(sp[3]) != null ? sp[3] : Presets.Classic;
                if (int.TryParse(sp[4], out var sf)) opt.Freq = (Frequency)Math.Clamp(sf, 0, 3);
            }
            if (sp.Length >= 6 && sp[5].Length > 0) opt.Custom = sp[5];
            if (sp.Length == 7 && (sp[6] is "white" or "black" or "random")) opt.PlayAs = sp[6];
            opt.Mode = sp[0] == "mystery" ? SquareMode.Mystery : SquareMode.Revealed;
            opt.Ai = savedAi;
            haveSettings = true;
        }

        bool restored = !string.IsNullOrEmpty(saved) && S.Restore(saved);
        bool firstEver = false;
        if (!restored)
        {
            firstEver = played == null && !tut.Off && opt.Tutorials;
            opt.Training = firstEver; // someone's very first game is a guided one on the full board
            if (firstEver || haveSettings) StartNew(persist: false);
            opt.Training = false;
        }
        EnablePersist();
        try { await JS.InvokeVoidAsync("localStorage.setItem", PlayedKey, "1"); } catch { }
        // A cold start opens the menu (not for someone's very first, guided game). A game in progress waits behind it.
        showMenu = !firstEver;
        if (restored) { if (showMenu) pendingResume = true; else await S.ResumeAi(); }
    }

    // ---------- start menu, options, about ----------

    bool showMenu, showOptions, showAbout, pendingResume, synthRunning;

    // the menu's animated background starts once its canvas is on the page
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (showMenu && !synthRunning)
        {
            synthRunning = true;
            try { await JS.InvokeVoidAsync("pcsynth.start", "menuBg"); } catch { }
        }
        else if (!showMenu) synthRunning = false;
    }

    void OpenMenu() { showMenu = true; }
    void CloseAbout() { showAbout = false; shareMsg = ""; }

    async Task ResumeIfPending()
    {
        if (!pendingResume) return;
        pendingResume = false;
        await S.ResumeAi();
    }

    async Task MenuContinue()
    {
        showMenu = false;
        await ResumeIfPending();
    }

    async Task MenuPlay()
    {
        showMenu = false;
        await ResumeIfPending();
        OpenNew();
    }

    async Task MenuDaily()
    {
        showMenu = false;
        await ResumeIfPending();
        await OpenDaily();
    }

    /// <summary>Remember the New game choices (also used by the Options sheet).</summary>
    void SaveSettings()
    {
        _ = SetItemAsync(SettingsKey, (opt.Mode == SquareMode.Revealed ? "revealed" : "mystery") + ":" + opt.Ai + ":" + (opt.Drama ? "1" : "0") + ":" + opt.Preset + ":" + (int)opt.Freq + ":" + opt.Custom + ":" + opt.PlayAs);
    }

    async Task SetMuted(bool want)
    {
        if (muted != want) await ToggleMute();
    }

    void SetDrama(bool on) { opt.Drama = on; SaveSettings(); }
    void SetPlayAs(string side) { opt.PlayAs = side; SaveSettings(); }
    void SetTutorialsOff(bool off) { S.SetTutorialsOff(off); }

    void StartTraining()
    {
        showHelp = false;
        opt.Training = true;
        StartNew();
        opt.Training = false;
    }

    void ResetTutorials()
    {
        S.ResetTutorials();
    }

    static string TutorialTitle(PowerupKind k) => PowerupInfo.IsTransform(k) ? "Transform squares" : Names.Name(k);

    static string TutorialText(PowerupKind k) => PowerupInfo.IsTransform(k)
        ? "The piece that opens one changes into another piece on the spot. Never a king."
        : k == PowerupKind.Leap
        ? "Checkers I jumps a rival on the next diagonal square, like a checker, and captures it. Land on another Checkers square for II (two jumps in a row) and again for III (jump as long as you can). Uses your turn, one use."
        : Names.Desc(k);

