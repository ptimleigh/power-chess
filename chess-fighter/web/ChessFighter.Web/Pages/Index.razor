    /// <summary>The first part of the saved file's name: chess-fighter-win-checkmate. The date and time are added in the browser.</summary>
    string ClipNameStem()
    {
        string outcome = S.Result switch
        {
            GameResult.Draw => "draw",
            GameResult.WhiteWins => S.VsAi ? "win" : "white-wins",
            GameResult.BlackWins => S.VsAi ? "loss" : "black-wins",
            _ => "game",
        };
