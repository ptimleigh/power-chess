@page "/"
@implements IDisposable
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ChessFighter.Web.Game.Platform.IAdService Ads

<PageTitle>Chess Fighter</PageTitle>

<div class="app" data-cardstep="@PrepCardAim()">
    <header class="topbar">
        <div class="logo" data-action="logo" @onclick="LogoTap">CHESS<span>FIGHTER</span></div>
        <div class="controls">
            <button class="icon-btn @(muted ? "muted" : "")" @onclick="ToggleMute" title="Sound" aria-label="Toggle sound">SFX</button>
            <button class="icon-btn daily" data-action="daily" title="Daily challenge" @onclick="OpenDaily"><span>Daily</span>@if (!Daily.SolvedToday(profile, today)) { <i class="dot"></i> }</button>
            <button class="icon-btn lvl" data-action="profile" title="Profile" @onclick="() => { showProfile = true; unseenUnlocks = false; showNextPreview = false; }">Lv <b>@profile.Level</b>@if (unseenUnlocks) { <i class="new-dot" data-testid="new-dot"></i> }</button>
            <button class="icon-btn" @onclick="() => showHelp = true" title="How to play" aria-label="How to play">?</button>
            <button class="icon-btn wide" data-action="new" @onclick="OpenNew">New</button>
        </div>
    </header>

    <section class="fight-hud" data-testid="fight-hud" aria-label="Health">
        <div class="fh-side p1 @(S.Turn == Side.White && !S.GameOver ? "turn" : "")">
            <div class="hp" title="Material left"><i style="width:@Hp(Side.White)%"></i></div>
            <div class="fh-name">P1</div>
        </div>
        <div class="fh-center">
            <div class="fh-ko">K.O.</div>
            <div class="fh-move">@S.Moves.ToString("00")</div>
        </div>
        <div class="fh-side p2 @(S.Turn == Side.Black && !S.GameOver ? "turn" : "")">
            <div class="hp" title="Material left"><i style="width:@Hp(Side.Black)%"></i></div>
            <div class="fh-name">@(S.VsAi ? "CPU" : "P2")</div>
        </div>
    </section>

    <section class="player opp @(S.Turn == Side.Black && !S.GameOver ? "active" : "")">
        <div class="avatar b"></div>
        <div class="pinfo">
            <div class="pname"><span class="ptag">@(S.VsAi ? "CPU" : "P2")</span>@(S.VsAi ? "Rival" : "Black")</div>
        </div>
        <div class="chips">@InvChips(Side.Black)</div>
    </section>
    @Bag(Side.Black)

    @if (S.Puzzle is PuzzleDef pz)
    {
        <section class="puzzle-hud" data-testid="puzzle-hud">
            <div class="ph-main">
                <b>@pz.Title</b>
                <span class="ph-goal">Checkmate in @pz.MaxMoves @(pz.MaxMoves == 1 ? "move" : "moves") · <span data-testid="puzzle-count">@S.PuzzleMoves/@pz.MaxMoves</span> used</span>
                <small>@pz.Hint</small>
            </div>
            <div class="ph-btns">
                <button class="btn small" data-action="puzzle-retry" @onclick="RetryPuzzle">Retry</button>
                <button class="btn small ghost" data-action="puzzle-quit" @onclick="QuitPuzzle">Quit</button>
            </div>
        </section>
    }

    @if (S.RoundIntro)
    {
        <div class="round-banner" @key="S.GameSerial" aria-hidden="true">
            <div class="rb-round">ROUND @S.GameSerial</div>
            <div class="rb-fight">FIGHT!</div>
        </div>
    }

    @if (S.SummonSplash != CardKind.None)
    {
        <div class="summon-splash s-@S.SummonSplash.ToString().ToLowerInvariant()" @key="@("summon" + S.SummonSerial)" aria-hidden="true" data-testid="summon-splash">
            <img src="img/summons/@(S.SummonSplash == CardKind.SummonShiva ? "shiva" : S.SummonSplash == CardKind.SummonMars ? "mars" : "caissa").png" alt="" />
            <div class="ss-name">@Names.CardShort(S.SummonSplash).ToUpperInvariant()!<small>@(S.VsAi ? (S.SummonBy == Side.White ? "YOU SUMMON" : "RIVAL SUMMONS") : (S.SummonBy == Side.White ? "WHITE SUMMONS" : "BLACK SUMMONS"))</small></div>
        </div>
    }

    <div class="board-frame">
        <div class="board @(S.Flipping ? "flipping" : "") @(S.Shaking ? "shaking sk" + S.ShakeLevel : "") @(S.Frozen ? "freeze" : "") @(S.Punch ? "punch" : "")" data-testid="board">
            @for (int rank = 7; rank >= 0; rank--)
            {
                for (int file = 0; file < 8; file++)
                {
                    int sq = Sq.Make(file, rank);
                    <div class="@TileClass(sq)" data-sq="@Sq.Name(sq)" data-content="@ContentName(sq)" data-mcount="@(missileZone.Contains(sq) && sq == S.MissileAnchorSquare ? S.MissileCountdown.ToString() : null)" @onclick="() => S.TapSquare(sq)">
                        @if (S.View.Mystery[sq])
                        {
                            <PowerupMark Kind="(PowerupKind)S.View.Content[sq]" />
                        }
                        else if (S.View.Portal[sq])
                        {
                            <span class="pu-edge"></span>
                            <span class="pu-glyph">@Icons.Svg("portal")</span>
                        }
                        @if (S.View.Boulders[sq])
                        {
                            <span class="boulder">@Icons.Svg("rock")</span>
                        }
                        @if (file == 0)
                        {
                            <i class="coord rank">@(rank + 1)</i>
                        }
                        @if (rank == 0)
                        {
                            <i class="coord file">@((char)('a' + file))</i>
                        }
                    </div>
                }
            }

            <div class="layer pieces">
                @foreach (var p in S.ViewPieces)
                {
                    <PieceItem @key="p.Id" P="p" Lifted="@(p.Square == S.Selected)" />
                }
            </div>

            <div class="layer fx">
                <FxLayer Items="S.Effects" />
            </div>

            <div class="toasts">
                @foreach (var t in S.Toasts)
                {
                    <div @key="t.Id" class="toast @t.Css">
                        <span class="ticon">@Icons.Svg(t.Icon)</span>
                        <span class="ttext"><b>@t.Title</b>@if (t.Text != "") { <small>@t.Text</small> }</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <section class="player me @(S.Turn == Side.White && !S.GameOver ? "active" : "")">
        <div class="avatar w"></div>
        <div class="pinfo">
            <div class="pname"><span class="ptag">P1</span>@(S.VsAi ? "You" : "White")@if (RulesLabel.Length > 0) { <span class="rules-badge" data-testid="rules-badge">@RulesLabel</span> }</div>
        </div>
        <div class="chips">@InvChips(Side.White)</div>
    </section>
    @Bag(Side.White)

    <section class="actions">
        @if (S.Responding && S.HumanTurn)
        {
            <div class="card-prompt" data-testid="respond">
                <div class="cp-title">@Names.CardName(S.State.RespCard)</div>
                <div class="row">
                    @if (S.CanRespondNuhUh)
                    {
                        <button class="btn primary" data-action="nuhuh" @onclick="() => S.Respond(true)">Nuh-uh!</button>
                    }
                    <button class="btn" data-action="allow" @onclick="() => S.Respond(false)">Allow</button>
                </div>
            </div>
        }
        else if (S.ActiveCard != CardKind.None && S.HumanTurn)
        {
            var cstep = S.NextCardStep(out _, out var cextras);
            <div class="card-prompt" data-testid="card-step">
                <div class="cp-title">@Names.CardName(S.ActiveCard)</div>
                @if (S.CardPreview >= 0)
                {
                    <div class="cp-note" data-testid="card-preview">@S.CardPreviewNote</div>
                }
                <div class="row">
                    @if (S.CardPreview >= 0)
                    {
                        <button class="btn primary" data-action="card-fire" @onclick="S.ConfirmPreview">Fire</button>
                    }
                    @if (cstep == GameSession.CardStep.Confirm)
                    {
                        <button class="btn primary" data-action="card-play" @onclick="S.ConfirmCard">Play</button>
                    }
                    @if (cstep == GameSession.CardStep.Extra)
                    {
                        @foreach (var ex in cextras)
                        {
                            var exv = ex;
                            <button class="btn promo-btn" data-extra="@exv" @onclick="() => S.ChooseCardExtra(exv)"><PieceSvg Type="(PieceType)exv" Side="S.Turn" /></button>
                        }
                    }
                    @if (S.State.PendingCard == CardKind.None)
                    {
                        <button class="btn ghost" data-action="card-cancel" @onclick="S.CancelCard">Cancel</button>
                    }
                </div>
            </div>
        }
        @if (S.Reviewing)
        {
            <div class="review" data-testid="review">
                <div class="review-label" data-testid="review-label">
                    <span class="rp">Move @S.ReviewPosition of @S.HistoryCount</span>
                    <span>@S.ReviewLabel</span>
                </div>
                <div class="review-btns">
                    <button class="rbtn" data-review="first" disabled="@(S.ReviewPosition <= 0)" aria-label="First" @onclick="() => S.ReviewTo(0)">@Icons.Svg("first")</button>
                    <button class="rbtn" data-review="prev" disabled="@(S.ReviewPosition <= 0)" aria-label="Previous move" @onclick="() => S.ReviewStep(-1)">@Icons.Svg("prev")</button>
                    <button class="rbtn" data-review="next" aria-label="Next move" @onclick="() => S.ReviewStep(1)">@Icons.Svg("next")</button>
                    <button class="rbtn" data-review="last" aria-label="Final position" disabled="@(S.ReviewPosition >= S.HistoryCount)" @onclick="() => S.ReviewTo(S.HistoryCount)">@Icons.Svg("last")</button>
                    <button class="btn primary review-exit" data-action="exit-review" @onclick="S.ExitReview">Back to game</button>
                    <button class="btn yellow small" data-action="open-clip" @onclick="OpenClip">Watch Replay!</button>
                </div>
            </div>
        }
        else
        {
        @foreach (var perk in PerkButtons)
        {
            var k = perk;
            if (S.Perk(ActiveSide, k.Kind) == 0) { continue; } // perks only show once you hold one (Chess Fighter squares no longer hand them out)
            if (k.Action == ActionKind.ClearBoulder && S.State.BoulderCount() == 0) { continue; }
            if (k.Kind == PowerupKind.Swap && S.Perk(ActiveSide, PowerupKind.Swap) == 0) { continue; }
            <button class="perk @(S.Mode == InputMode.Armed && S.ArmedKind == k.Action ? "on" : "")" disabled="@(!S.CanUse(k.Action))"
                    data-perk="@k.Kind.ToString().ToLowerInvariant()" @onclick="() => S.Arm(k.Action)">
                <span class="pi">@Icons.Svg(Names.Icon(k.Kind))</span>
                <span class="pl">@k.Label</span>
                <span class="pc">@S.Perk(ActiveSide, k.Kind)</span>
            </button>
        }
        @if (S.Perk(ActiveSide, PowerupKind.Rewind) > 0)
        {
            <button class="perk" disabled="@(!S.CanRewind)" data-perk="rewind" @onclick="S.RewindClick">
                <span class="pi">@Icons.Svg("rewind")</span>
                <span class="pl">Rewind</span>
                <span class="pc">@S.Perk(ActiveSide, PowerupKind.Rewind)</span>
            </button>
        }
        @if (S.HasFireball)
        {
            <button class="perk fire-btn" data-action="fire" @onclick="S.StartFire">
                <span class="pi">@Icons.Svg("fire")</span><span class="pl">Fireball</span>
            </button>
        }
        @if (S.HasHarpoon)
        {
            <button class="perk fire-btn" data-action="harpoon" @onclick="S.StartHarpoon">
                <span class="pi">@Icons.Svg("hook")</span><span class="pl">Harpoon</span>
            </button>
        }
        @if (S.HasDetonate)
        {
            <button class="perk boom-btn" data-action="detonate" @onclick="S.PreviewBomb">
                <span class="pi">@Icons.Svg("bomb")</span><span class="pl">Detonate</span>
            </button>
        }
        @if (S.Mode == InputMode.BombPreview)
        {
            <button class="perk boom-btn" data-action="bomb-confirm" @onclick="S.Detonate">
                <span class="pi">@Icons.Svg("bomb")</span><span class="pl">Confirm blast</span>
            </button>
        }
        @if (S.Mode != InputMode.Normal && S.Mode != InputMode.Promotion)
        {
            <button class="perk ghost" @onclick="S.Cancel"><span class="pl">Cancel</span></button>
        }
        @if (S.HintAvailable)
        {
            @if (S.HintsLeft > 0)
            {
                <button class="perk hint-btn" data-action="hint" @onclick="S.Hint">
                    <span class="pi">@Icons.Svg("spark")</span><span class="pl">Hint</span><span class="pn" data-testid="hints-left">@S.HintsLeft</span>
                </button>
            }
            else if (adsAvailable)
            {
                <button class="perk hint-btn" data-action="hint-ad" disabled="@adBusy" @onclick="BuyHint">
                    <span class="pi">@Icons.Svg("spark")</span><span class="pl">@(adBusy ? "Loading ad..." : "Watch an ad for a hint")</span>
                </button>
            }
            else
            {
                <button class="perk hint-btn" data-action="hint" disabled title="No hints left this game">
                    <span class="pi">@Icons.Svg("spark")</span><span class="pl">No hints left</span>
                </button>
            }
        }
        @if (S.CanReview)
        {
            <button class="perk ghost" data-action="review" @onclick="() => S.ReviewStep(-1)">
                <span class="pi">@Icons.Svg("history")</span><span class="pl">Moves</span>
            </button>
        }
        }
    </section>

    @if (showDebug)
    {
        <section class="debug" data-testid="debug">
            <div class="debug-head"><b>DEBUG</b><small>@(S.DebugHint == "" ? "Pick a tool, then tap the board" : S.DebugHint)</small>
                <button class="x" aria-label="Close debug" @onclick="CloseDebug">x</button></div>
            <div class="debug-row"><span>Cards to @(S.DebugCardsToRival ? "rival" : "you")</span>
                <button class="dbtn @(S.DebugCardsToRival ? "on" : "")" data-dcards="side" @onclick="S.DebugToggleCardSide">@(S.DebugCardsToRival ? "Rival" : "You")</button>
                @foreach (var k in CardKinds)
                {
                    var kk = k;
                    <button class="dbtn" data-dcard="@kk.ToString().ToLowerInvariant()" @onclick="() => S.DebugGiveCard(kk)">@Names.CardShort(kk)</button>
                }
                <button class="dbtn warn" data-dcards="clear" @onclick="S.DebugClearBags">Clear bags</button>
            </div>
            <div class="debug-row"><span>Power a piece</span>
                @foreach (var (label, kind, times) in DebugBuffs)
                {
                    var kk = kind; var tt = times;
                    <button class="dbtn @(S.DebugArmed == DebugTool.Buff && S.DebugKind == kk && S.DebugTimes == tt ? "on" : "")" data-dbuff="@(kk.ToString().ToLowerInvariant() + (tt > 1 ? "2" : ""))" @onclick="() => S.DebugArm(DebugTool.Buff, kk, tt)">@label</button>
                }
                <button class="dbtn warn @(S.DebugArmed == DebugTool.Unbuff ? "on" : "")" data-dbuff="strip" @onclick="() => S.DebugArm(DebugTool.Unbuff)">Strip</button>
                <button class="dbtn @(S.DebugArmed == DebugTool.Stun ? "on" : "")" data-dbuff="stun" @onclick="() => S.DebugArm(DebugTool.Stun)">Stun</button>
            </div>
            <div class="debug-row"><span>Drop square</span>
                <button class="dbtn @(S.DebugArmed == DebugTool.Square && S.DebugKind == PowerupKind.None ? "on" : "")" data-dsquare="hidden" @onclick="() => S.DebugArm(DebugTool.Square, PowerupKind.None)">? Mystery</button>
                @foreach (var k in DebugSquares)
                {
                    var kk = k;
                    <button class="dbtn @(S.DebugArmed == DebugTool.Square && S.DebugKind == kk ? "on" : "")" data-dsquare="@kk.ToString().ToLowerInvariant()" @onclick="() => S.DebugArm(DebugTool.Square, kk)">@Names.Name(kk)</button>
                }
                <button class="dbtn @(S.DebugArmed == DebugTool.Portal ? "on" : "")" data-dsquare="portal" @onclick="() => S.DebugArm(DebugTool.Portal)">Teleporters</button>
                <button class="dbtn warn @(S.DebugArmed == DebugTool.Clear ? "on" : "")" data-dsquare="clear" @onclick="() => S.DebugArm(DebugTool.Clear)">Remove</button>
            </div>
            <div class="debug-row"><span>Board</span>
                <button class="dbtn" data-dboard="spawn" @onclick="S.DebugSpawn">Spawn pair</button>
                <button class="dbtn warn" data-dboard="clear" @onclick="S.DebugClearBoard">Clear all powers</button>
            </div>
            <div class="debug-row"><span>Scramble</span>
                <button class="dbtn" data-dboard="scramble-early" @onclick="() => S.DebugScramble(16)">Early (16)</button>
                <button class="dbtn" data-dboard="scramble-mid" @onclick="() => S.DebugScramble(40)">Middle (40)</button>
                <button class="dbtn" data-dboard="scramble-late" @onclick="() => S.DebugScramble(80)">Late (80)</button>
            </div>
            <div class="debug-row"><span>Progress</span>
                <button class="dbtn" data-dprog="max" @onclick="() => DebugXp(Progression.XpForLevel(Progression.MaxLevel))">Max level</button>
                <button class="dbtn" data-dprog="plus" @onclick="() => DebugXp(profile.Xp + 100)">+100 XP</button>
                <button class="dbtn" data-dprog="nextday" @onclick="() => today++">Next day</button>
                <button class="dbtn warn" data-dprog="reset" @onclick="() => DebugXp(0, true)">Reset profile</button>
            </div>
        </section>
    }

    <div class="status @(S.InCheck && !S.GameOver ? "warn" : "")" data-testid="status">@S.Status</div>
    @if (S.HintText != "")
    {
        <div class="hint-line" data-testid="hint-text">@S.HintText</div>
    }

    @if (S.Inspect >= 0 && !S.Reviewing && S.Tutorial == null && !S.State.Cells[S.Inspect].IsEmpty)
    {
        var ip = S.State.Cells[S.Inspect];
        <div class="inspect" data-testid="inspect">
            <div class="inspect-head">
                <b>@InspectTitle(ip)</b>
                <button class="x" aria-label="Close" @onclick="S.CloseInspect">x</button>
            </div>
            @foreach (var flag in new[] { Buff.DoubleMove, Buff.TripleMove, Buff.Ghost, Buff.Poison, Buff.Armor, Buff.Fireball, Buff.Harpoon, Buff.SmallBomb, Buff.BigBomb })
            {
                if (!ip.Has(flag)) { continue; }
                var kind = Names.ForBuff(flag);
                <div class="inspect-row">
                    <span class="gi buff">@Icons.Svg(Names.Icon(kind))</span>
                    <span>
                        <b>@Names.TierName(kind, ip.Tier)</b>
                        @(flag == Buff.Armor
                            ? $"Immune to capture and effects for {ip.ArmorTurns} more opponent {(ip.ArmorTurns == 1 ? "turn" : "turns")}."
                            : flag == Buff.Ghost
                            ? $"Slides through pieces and boulders for {ip.GhostTurns} more of its owner's {(ip.GhostTurns == 1 ? "turn" : "turns")}."
                            : Names.Desc(kind, ip.Tier))
                    </span>
                    <button class="demo-btn" data-demo="@kind.ToString().ToLowerInvariant()" @onclick="() => S.ShowTutorial(kind)">Demo</button>
                </div>
            }
            @if (ip.IsStunned)
            {
                <div class="inspect-row">
                    <span class="gi perk">@Icons.Svg("star")</span>
                    <span>
                        <b>Frozen</b>
                        @($"Can't move for {ip.StunTurns} more of its owner's {(ip.StunTurns == 1 ? "turn" : "turns")}, and can't give check.")
                    </span>
                    <button class="demo-btn" data-demo="stun" @onclick="() => S.ShowTutorial(PowerupKind.Stun)">Demo</button>
                </div>
            }
        </div>
    }
</div>

@if (S.InspectSquare >= 0 && !S.Reviewing && S.Tutorial == null && S.State.Portal[S.InspectSquare] && !S.State.Mystery[S.InspectSquare])
{
    <div class="inspect sqinfo" data-testid="inspect-square" data-content="portal">
        <div class="inspect-head">
            <b>Teleporter</b>
            <button class="x" aria-label="Close" @onclick="S.CloseInspect">x</button>
        </div>
        <div class="inspect-row">
            <span class="gi perk">@Icons.Svg("portal")</span>
            <span>@Names.PortalDesc</span>
        </div>
    </div>
}
else if (S.InspectSquare >= 0 && !S.Reviewing && S.Tutorial == null && S.State.Mystery[S.InspectSquare])
{
    var sk = (PowerupKind)S.State.Content[S.InspectSquare];
    <div class="inspect sqinfo" data-testid="inspect-square" data-content="@ContentName(S.InspectSquare)">
        <div class="inspect-head">
            <b>@(sk == PowerupKind.None ? "Mystery square" : Names.Name(sk))</b>
            <button class="x" aria-label="Close" @onclick="S.CloseInspect">x</button>
        </div>
        <div class="inspect-row">
            <span class="gi @(sk != PowerupKind.None && PowerupInfo.IsPerk(sk) ? "perk" : "buff")">@(sk == PowerupKind.None ? Icons.Svg("question") : Icons.Svg(Names.Icon(sk)))</span>
            <span>@(sk == PowerupKind.None ? "Land a piece here to find out what it holds. Squares appear in matching pairs." : Names.Desc(sk))</span>
            @if (sk != PowerupKind.None)
            {
                <button class="demo-btn" data-demo="@sk.ToString().ToLowerInvariant()" @onclick="() => S.ShowTutorial(sk)">Demo</button>
            }
        </div>
    </div>
}

@if (S.Tutorial is PowerupKind tk)
{
    <div class="tutorial" data-testid="tutorial" data-kind="@tk.ToString().ToLowerInvariant()">
        <DemoBoard Kind="tk" />
        <div class="tut-text">
            <div class="tut-title">
                <span class="gi @(PowerupInfo.IsPerk(tk) ? "perk" : "buff")">@Icons.Svg(Names.Icon(tk))</span>
                <b>@TutorialTitle(tk)</b>
            </div>
            <p>@TutorialText(tk)</p>
            <label class="chk"><input type="checkbox" data-testid="tut-off" @bind="S.DontShowAgain" /> Don't show tutorials again</label>
            <button class="btn primary tut-ok" data-action="tutorial-ok" @onclick="S.DismissTutorial">Got it</button>
        </div>
    </div>
}

@if (S.PickupPending && S.HumanTurn)
{
    var kind = S.State.PendingKind;
    <div class="modal" data-testid="pickup">
        <div class="card pop">
            <div class="kicker">Mystery square!</div>
            <div class="big-icon @(PowerupInfo.IsPerk(kind) ? "perk" : "buff")">@Icons.Svg(Names.Icon(kind))</div>
            <h2>@Names.Name(kind)</h2>
            <p>@Names.Desc(kind)</p>
            @if (S.PickupTutorial)
            {
                <DemoBoard Kind="kind" />
                <label class="chk"><input type="checkbox" data-testid="tut-off" @bind="S.DontShowAgain" /> Don't show tutorials again</label>
            }
            <div class="row">
                <button class="btn primary" data-action="keep" @onclick="S.KeepPickup">Keep it</button>
                @if (S.Perk(S.Turn, PowerupKind.Reroll) > 0)
                {
                    <button class="btn" data-action="reroll" @onclick="S.RerollPickup">Reroll (@S.Perk(S.Turn, PowerupKind.Reroll))</button>
                }
            </div>
        </div>
    </div>
}

@if (S.Mode == InputMode.Promotion)
{
    <div class="modal" data-testid="promotion">
        <div class="card pop">
            <div class="kicker">Promote your pawn</div>
            <div class="row promo">
                @foreach (var a in S.PromoChoices)
                {
                    var choice = a;
