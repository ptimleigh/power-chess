            + $"Build: {ChessFighter.Web.Game.BuildInfo.Label}\n"
            + $"Level: {profile.Level} ({profile.Xp} XP), games played {profile.Games}\n"
            + $"Opponent: {Ai.LevelName(opt.Ai)}, rules: {(Presets.Label(opt.Preset, opt.Freq, EffectiveLevel) is { Length: > 0 } r ? r : "Standard")}\n"
            + $"Current game: {last}\n"
