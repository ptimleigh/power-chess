    /// <summary>Records the clip (this takes as long as the clip, in real time). Sharing is a separate tap: phones only open the share sheet straight after a tap.</summary>
    async Task RenderClip()
    {
        clipBusy = true;
        clipReady = false;
        clipMsg = "Rendering your clip in real time...";
        StateHasChanged();
        try { await JS.InvokeVoidAsync("pcclip.stop"); } catch { }
        try
        {
            var res = await JS.InvokeAsync<ClipResult>("pcclip.record", BuildClipJson(), ClipNameStem());
            if (!res.Ok) clipMsg = res.Error ?? "Recording failed.";
            else { clipReady = true; clipMsg = "Your video is ready."; }
        }
        catch (Exception ex) { clipMsg = "Recording failed: " + ex.Message; }
        clipBusy = false;
    }

