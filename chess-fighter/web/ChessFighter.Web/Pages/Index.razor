@code {
    GameOptions opt = new();
    bool urlSeed;
    bool muted;
    bool showHelp;
    bool showNew;
    bool showProfile;
    bool showDaily;
    bool shared;
    int today;
    MatchReward? puzzleReward;
    bool showDebug;
    Profile profile = new();
    MatchReward? reward;
    int EffectiveLevel => opt.Level < 0 ? Progression.MaxLevel : opt.Level;

    static int XpPercent(Profile p)
    {
        if (p.Level >= Progression.MaxLevel) return 100;
        int lo = Progression.XpForLevel(p.Level), hi = Progression.XpForLevel(p.Level + 1);
        return Math.Clamp((p.Xp - lo) * 100 / Math.Max(1, hi - lo), 0, 100);
    }

    string NextUnlockText
    {
        get
        {
            if (profile.Level >= Progression.MaxLevel) return "Max level. Everything is unlocked.";
            int next = profile.Level + 1;
            var names = Unlocks.AtLevel(next).Select(i => i.Type == UnlockType.Powerup ? Names.Name(i.Kind) : i.Type == UnlockType.Cards ? string.Join(" / ", i.CardKinds.Select(Names.CardShort)) + " cards" : i.Name).ToList();
            return $"{Progression.XpForLevel(next) - profile.Xp} XP to level {next}" + (names.Count > 0 ? ": unlocks " + string.Join(", ", names) : "");
        }
    }

    async Task RefreshToday()
    {
        if (opt.Day is int forced) { if (today < forced) today = forced; return; }
        try { today = await JS.InvokeAsync<int>("pcfx.today"); }
        catch { today = Daily.DayNumber(DateTime.Now); }
    }

    async Task OpenDaily()
    {
        await RefreshToday();
        showDaily = true;
    }

    void WireSession()
    {
        S.Changed = () => InvokeAsync(StateHasChanged);
        S.TutorialsChanged = text => { _ = SetItemAsync(TutKey, text); };
        S.Sfx = name => { _ = PlaySfx(name); };
        S.GameEnded = OnGameEnded;
        S.PuzzleSolved = OnPuzzleSolved;
    }

    void StartPuzzle()
    {
        showDaily = false;
        shared = false;
        puzzleReward = null;
        var def = Daily.PuzzleFor(today);
        var popt = new GameOptions { Ai = 2, Puzzle = def, Seed = (ulong)DateTime.UtcNow.Ticks, Tutorials = opt.Tutorials, Drama = opt.Drama, Mode = opt.Mode, Level = -1 };
        if (S != null) { S.Changed = null; S.Sfx = null; S.Persist = null; }
        S = new GameSession(popt, tut);
        WireSession();
        reward = null;
    }

    void RetryPuzzle()
    {
        if (S.Puzzle != null) StartPuzzle();
    }

    async Task QuitPuzzle()
    {
        puzzleReward = null;
        StartNew(persist: false);
        string? saved = null;
        if (!debugOptions)
        {
            try { saved = await JS.InvokeAsync<string?>("localStorage.getItem", SaveKey); } catch { }
        }
        bool restored = !string.IsNullOrEmpty(saved) && S.Restore(saved);
        if (!debugOptions) EnablePersist();
        if (restored) await S.ResumeAi();
    }

    void OnPuzzleSolved(PuzzleDef def, int moves)
    {
        puzzleReward = Daily.AwardSolve(profile, today);
        _ = SetItemAsync(ProfileKey, ProfileCodec.Encode(profile));
        puzzleMoves = moves;
    }
    int puzzleMoves;

    async Task SharePuzzle()
    {
        var def = Daily.PuzzleFor(today);
        string text = $"Chess Fighter Daily {DateTime.UnixEpoch.AddDays(today):MMM d}: \"{def.Title}\" solved in {puzzleMoves}/{def.MaxMoves}. Streak {profile.DailyStreak}. https://ptimleigh.github.io/power-chess/fighter/";
        try { shared = await JS.InvokeAsync<bool>("pcfx.copy", text); } catch { shared = false; }
    }

    void OnGameEnded(MatchSummary m)
    {
        if ((debugOptions && !opt.Rewards) || !S.Rewardable) { reward = null; return; }
        int xpBefore = profile.Xp;
        reward = Progression.Award(profile, m);
        RefreshUnlocks();
        opt.Level = profile.Level;
        _ = SetItemAsync(ProfileKey, ProfileCodec.Encode(profile));
        _ = RunXpAnim(xpBefore, profile.Xp);
    }

    // ---------- XP bar fill after a win ----------

    bool xpAnimDone = true, animSnap, showXpDetail;
    int animPct, animLevel;
    int xpAnimSerial;

    static int PctIn(int xp, int level)
    {
        if (level >= Progression.MaxLevel) return 100;
        int lo = Progression.XpForLevel(level), hi = Progression.XpForLevel(level + 1);
        return Math.Clamp((xp - lo) * 100 / Math.Max(1, hi - lo), 0, 100);
    }

    /// <summary>Fills the bar from where it was to where it is now. A level-up fills it to the top, flashes, empties and carries on.</summary>
    async Task RunXpAnim(int xpBefore, int xpAfter)
    {
        int serial = ++xpAnimSerial;
        int from = Progression.LevelForXp(xpBefore), to = Progression.LevelForXp(xpAfter);
        xpAnimDone = false;
        animLevel = from;
        animPct = PctIn(xpBefore, from);
        StateHasChanged();
        await Task.Delay(700);
        for (int lvl = from; lvl <= to; lvl++)
        {
            if (serial != xpAnimSerial) return;
            animLevel = lvl;
            animPct = lvl == to ? PctIn(xpAfter, lvl) : 100;
            StateHasChanged();
            await Task.Delay(1000);
            if (lvl < to)
            {
                animLevel = lvl + 1;
                animSnap = true;
                animPct = 0;
                StateHasChanged();
                await Task.Delay(120);
                animSnap = false;
                StateHasChanged();
                await Task.Delay(120);
            }
        }
        if (serial != xpAnimSerial) return;
        xpAnimDone = true;
        StateHasChanged();
    }

    void DebugXp(int xp, bool reset = false)
    {
        if (reset) profile = new Profile(); else profile.Xp = xp;
        opt.Level = debugOptions && opt.Level >= 0 && !reset ? opt.Level : profile.Level;
        _ = SetItemAsync(ProfileKey, ProfileCodec.Encode(profile));
    }
    const string ProfileKey = "chessfighter.profile.v1";
    int logoTaps;
    DateTime lastLogoTap;

