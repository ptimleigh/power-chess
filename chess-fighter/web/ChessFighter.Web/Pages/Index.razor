@page "/"
@implements IDisposable
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ChessFighter.Web.Game.Platform.IAdService Ads

<PageTitle>Chess Fighter</PageTitle>

<div class="app" data-cardstep="@PrepCardAim()">
    <header class="topbar">
        <div class="logo" data-action="logo" @onclick="LogoTap"><img src="img/logo.png" alt="Chess Fighter" draggable="false" /></div>
        <div class="controls">
            <button class="icon-btn @(muted ? "muted" : "")" @onclick="ToggleMute" title="Sound" aria-label="Toggle sound">SFX</button>
            <button class="icon-btn daily" data-action="daily" title="Daily challenge" @onclick="OpenDaily"><span>Daily</span>@if (!Daily.SolvedToday(profile, today)) { <i class="dot"></i> }</button>
            <button class="icon-btn lvl" data-action="profile" title="Profile" @onclick="() => { showProfile = true; unseenUnlocks = false; showNextPreview = false; }">Lv <b>@profile.Level</b>@if (unseenUnlocks) { <i class="new-dot" data-testid="new-dot"></i> }</button>
            <button class="icon-btn" data-action="menu" @onclick="OpenMenu" title="Menu" aria-label="Menu">@Icons.Svg("menu")</button>
            <button class="icon-btn wide" data-action="new" @onclick="OpenNew">New</button>
        </div>
    </header>

    <section class="fight-hud" data-testid="fight-hud" aria-label="Health">
        <div class="fh-side p1 @(S.Turn == S.HumanSide && !S.GameOver ? "turn" : "")">
            <div class="hp" title="Material left"><i style="width:@Hp(S.HumanSide)%"></i></div>
            <div class="fh-name">P1</div>
        </div>
        <div class="fh-center">
            <div class="fh-ko">K.O.</div>
            <div class="fh-move">@S.Moves.ToString("00")</div>
        </div>
        <div class="fh-side p2 @(S.Turn == S.RivalSide && !S.GameOver ? "turn" : "")">
            <div class="hp" title="Material left"><i style="width:@Hp(S.RivalSide)%"></i></div>
            <div class="fh-name">@(S.VsAi ? "CPU" : "P2")</div>
        </div>
    </section>

    <section class="player opp @(S.Turn == S.RivalSide && !S.GameOver ? "active" : "")">
        <div class="avatar @(S.RivalSide == Side.White ? "w" : "b")"></div>
        <div class="pinfo">
            <div class="pname"><span class="ptag">@(S.VsAi ? "CPU" : "P2")</span>@(S.VsAi ? "Rival" : "Black")</div>
        </div>
        <div class="chips">@InvChips(S.RivalSide)</div>
    </section>
    @Bag(S.RivalSide)

    @if (S.Puzzle is PuzzleDef pz)
    {
        <section class="puzzle-hud" data-testid="puzzle-hud">
            <div class="ph-main">
                <b>@pz.Title</b>
                <span class="ph-goal">Checkmate in @pz.MaxMoves @(pz.MaxMoves == 1 ? "move" : "moves") · <span data-testid="puzzle-count">@S.PuzzleMoves/@pz.MaxMoves</span> used</span>
                <small>@pz.Hint</small>
            </div>
            <div class="ph-btns">
                <button class="btn small" data-action="puzzle-retry" @onclick="RetryPuzzle">Retry</button>
                <button class="btn small ghost" data-action="puzzle-quit" @onclick="QuitPuzzle">Quit</button>
            </div>
        </section>
    }

    @if (S.RoundIntro)
    {
        <div class="round-banner" @key="S.GameSerial" aria-hidden="true">
            <div class="rb-round">ROUND @S.GameSerial</div>
            <div class="rb-fight">FIGHT!</div>
        </div>
    }

    @if (S.SummonSplash != CardKind.None)
    {
        <div class="summon-splash s-@S.SummonSplash.ToString().ToLowerInvariant()" @key="@("summon" + S.SummonSerial)" aria-hidden="true" data-testid="summon-splash">
            <img src="img/summons/@(S.SummonSplash == CardKind.SummonDeath ? "death" : S.SummonSplash == CardKind.SummonMars ? "mars" : "caissa").png" alt="" />
            <div class="ss-name">@Names.CardShort(S.SummonSplash).ToUpperInvariant()!<small>@(S.VsAi ? (S.SummonBy == S.HumanSide ? "YOU SUMMON" : "RIVAL SUMMONS") : (S.SummonBy == Side.White ? "WHITE SUMMONS" : "BLACK SUMMONS"))</small></div>
        </div>
    }

    <div class="board-frame">
        <div class="board @(S.Flipping ? "flipping" : "") @(S.Shaking ? "shaking sk" + S.ShakeLevel : "") @(S.Frozen ? "freeze" : "") @(S.Punch ? "punch" : "") @(S.FinaleOn ? "finale" : "") @(S.VsAi && S.HumanSide == Side.Black ? "pov-black" : "")" data-testid="board">
            @for (int rank = 7; rank >= 0; rank--)
            {
                for (int file = 0; file < 8; file++)
                {
                    int sq = Sq.Make(file, rank);
                    <div class="@TileClass(sq)" data-sq="@Sq.Name(sq)" data-content="@ContentName(sq)" data-mcount="@(missileZone.Contains(sq) && sq == S.MissileAnchorSquare ? S.MissileCountdown.ToString() : null)" @onclick="() => S.TapSquare(sq)">
                        @if (S.View.Mystery[sq])
                        {
                            <PowerupMark Kind="(PowerupKind)S.View.Content[sq]" />
                        }
                        else if (S.View.Portal[sq])
                        {
                            <span class="pu-edge"></span>
                            <span class="pu-glyph">@Icons.Svg("portal")</span>
                        }
                        @if (S.View.Boulders[sq])
                        {
                            <span class="boulder">@Icons.Svg("rock")</span>
                        }
                        @if (file == 0)
                        {
                            <i class="coord rank">@(rank + 1)</i>
                        }
                        @if (rank == 0)
                        {
                            <i class="coord file">@((char)('a' + file))</i>
                        }
                    </div>
                }
            }

            <div class="layer pieces">
                @foreach (var p in S.ViewPieces)
                {
                    <PieceItem @key="p.Id" P="p" Lifted="@(p.Square == S.Selected)" Lit="@(S.FinaleOn && (p.Square == S.FinaleKingSq || p.Square == S.FinaleAtkSq))" FallDir="@(S.FinaleOn && p.Square == S.FinaleKingSq ? S.FinaleFall : 0)" />
                }
            </div>

            <div class="layer fx">
                <FxLayer Items="S.Effects" />
            </div>

            @if (S.FinaleOn)
            {
                <div class="finale-hit" data-testid="finale" @onclick="S.SkipFinale">
                    @if (S.FinaleKo)
                    {
                        <div class="ko-big"><img class="ko-k" src="img/ko_k.png" alt="K" /><img class="ko-o" src="img/ko_o.png" alt="O" /></div>
                    }
                </div>
            }

        </div>
            <div class="toasts">
                @foreach (var t in S.Toasts)
                {
                    <div @key="t.Id" class="toast @t.Css @(t.Who is Side tw ? (tw == Side.White ? "by-white" : "by-black") : "")" style="--ms:@(t.Ms)ms" role="status" @onclick="() => S.DismissToast(t.Id)">
                        <span class="ticon">@Icons.Svg(t.Icon)</span>
                        <span class="ttext">@if (t.WhoLabel != "") { <i class="twho">@t.WhoLabel</i> }<b>@t.Title</b>@if (t.Text != "") { <small>@t.Text</small> }</span>
                    </div>
                }
            </div>
    </div>

    <section class="player me @(S.Turn == S.HumanSide && !S.GameOver ? "active" : "")">
        <div class="avatar @(S.HumanSide == Side.White ? "w" : "b")"></div>
        <div class="pinfo">
            <div class="pname"><span class="ptag">P1</span>@(S.VsAi ? "You" : "White")@if (RulesLabel.Length > 0) { <span class="rules-badge" data-testid="rules-badge">@RulesLabel</span> }</div>
        </div>
        <div class="chips">@InvChips(S.HumanSide)</div>
    </section>

    @if (S.Draw is DrawShow dr)
    {
        <div class="draw-overlay @(dr.Pick ? "pick" : "quick") @(dr.Side == Side.White ? "by-white" : "by-black")" data-testid="draw-overlay" data-phase="@dr.Phase" @onclick="S.DismissDraw">
            <div class="draw-who"><i class="twho">@dr.WhoLabel</i> @(dr.Phase == 0 ? "Pick a card!" : "drew")</div>
            <div class="draw-deck">
                @for (int i = 0; i < 3; i++)
                {
                    int ci = i;
                    bool chosen = dr.Phase == 1 && dr.Chosen == i;
                    <button class="dcard @(chosen ? "flip" : "") @(dr.Phase == 1 && !chosen ? "gone" : "")" style="--i:@ci" data-card-pick="@ci" disabled="@(!dr.Pick || dr.Phase != 0)"
                            @onclick="() => S.PickDrawCard(ci)" @onclick:stopPropagation="true" aria-label="Card @(ci + 1)">
                        <span class="dback"><b>?</b></span>
                        <span class="dface"><span class="dicon">@Icons.Svg(Names.CardIcon(dr.Card))</span><span class="dname">@Names.CardShort(dr.Card)</span></span>
                    </button>
                }
            </div>
            @if (dr.Phase == 1)
            {
                <div class="draw-info" data-testid="draw-info"><b>@Names.CardName(dr.Card)</b><small>@Names.CardDesc(dr.Card)</small><em>Tap to continue</em></div>
            }
        </div>
    }

    @if (S.CoachStep > 0 && !S.GameOver)
    {
        <div class="coach" data-testid="coach" data-step="@S.CoachStep">
            <div class="coach-text">@S.CoachText</div>
            <div class="coach-row">
                <span class="us-dots-btn">@for (int i = 1; i <= S.CoachCount; i++) { <i class="@(i == S.CoachStep ? "on" : "")"></i> }</span>
                <button class="btn small ghost" data-action="coach-skip" @onclick="S.EndCoach">@(S.CoachStep == 4 ? "Got it" : "Skip tutorial")</button>
            </div>
        </div>
    }
    @Bag(S.HumanSide)

    <section class="actions">
        @if (S.Responding && S.HumanTurn)
        {
            <div class="card-prompt" data-testid="respond">
                <div class="cp-title">@Names.CardName(S.State.RespCard)</div>
                <div class="row">
                    @if (S.CanRespondNuhUh)
                    {
                        <button class="btn primary" data-action="nuhuh" @onclick="() => S.Respond(true)">Nuh-uh!</button>
                    }
                    <button class="btn" data-action="allow" @onclick="() => S.Respond(false)">Allow</button>
                </div>
            </div>
        }
        else if (S.ActiveCard != CardKind.None && S.HumanTurn)
        {
            var cstep = S.NextCardStep(out _, out var cextras);
            <div class="card-prompt" data-testid="card-step">
                <div class="cp-title">@Names.CardName(S.ActiveCard)</div>
                @if (S.CardPreview >= 0)
                {
                    <div class="cp-note" data-testid="card-preview">@S.CardPreviewNote</div>
                }
                <div class="row">
                    @if (S.CardPreview >= 0)
                    {
                        <button class="btn primary" data-action="card-fire" @onclick="S.ConfirmPreview">Fire</button>
                    }
                    @if (cstep == GameSession.CardStep.Confirm)
                    {
                        <button class="btn primary" data-action="card-play" @onclick="S.ConfirmCard">Play</button>
                    }
                    @if (cstep == GameSession.CardStep.Extra)
                    {
                        @foreach (var ex in cextras)
                        {
                            var exv = ex;
                            <button class="btn promo-btn" data-extra="@exv" @onclick="() => S.ChooseCardExtra(exv)"><PieceSvg Type="(PieceType)exv" Side="S.Turn" /></button>
                        }
                    }
                    @if (S.State.PendingCard == CardKind.None)
                    {
                        <button class="btn ghost" data-action="card-cancel" @onclick="S.CancelCard">Cancel</button>
                    }
                </div>
            </div>
        }
        @if (S.Reviewing)
        {
            <div class="review" data-testid="review">
                <div class="review-label" data-testid="review-label">
                    <span class="rp">Move @S.ReviewPosition of @S.HistoryCount</span>
                    <span>@S.ReviewLabel</span>
                </div>
                <div class="review-btns">
                    <button class="btn yellow small" data-action="open-clip" disabled="@(S.ReviewPosition <= 0)" @onclick="OpenClip">Watch Replay!</button>
                </div>
                @HistoryNav
            </div>
        }
        else
        {
        @foreach (var perk in PerkButtons)
        {
            var k = perk;
            if (S.Perk(ActiveSide, k.Kind) == 0) { continue; } // perks only show once you hold one (Chess Fighter squares no longer hand them out)
            if (k.Action == ActionKind.ClearBoulder && S.State.BoulderCount() == 0) { continue; }
            if (k.Kind == PowerupKind.Swap && S.Perk(ActiveSide, PowerupKind.Swap) == 0) { continue; }
            <button class="perk @(S.Mode == InputMode.Armed && S.ArmedKind == k.Action ? "on" : "")" disabled="@(!S.CanUse(k.Action))"
                    data-perk="@k.Kind.ToString().ToLowerInvariant()" @onclick="() => S.Arm(k.Action)">
                <span class="pi">@Icons.Svg(Names.Icon(k.Kind))</span>
                <span class="pl">@k.Label</span>
                <span class="pc">@S.Perk(ActiveSide, k.Kind)</span>
            </button>
        }
        @if (S.Perk(ActiveSide, PowerupKind.Rewind) > 0)
        {
            <button class="perk" disabled="@(!S.CanRewind)" data-perk="rewind" @onclick="S.RewindClick">
                <span class="pi">@Icons.Svg("rewind")</span>
                <span class="pl">Rewind</span>
                <span class="pc">@S.Perk(ActiveSide, PowerupKind.Rewind)</span>
            </button>
        }
        @if (S.HoldsFireball)
        {
            <button class="perk fire-btn" data-action="fire" disabled="@(!S.HasFireball)" @onclick="S.StartFire">
                <span class="pi">@Icons.Svg("fire")</span><span class="pl">Fireball@(S.HasFireball ? "" : " (no target)")</span>
            </button>
        }
        @if (S.HoldsLeap)
        {
            <button class="perk fire-btn" data-action="leap" disabled="@(!S.HasLeap)" @onclick="S.StartLeap">
                <span class="pi">@Icons.Svg("checker")</span><span class="pl">Checkers@(S.HasLeap ? "" : " (no target)")</span>
            </button>
        }
        @if (S.EffectPending && S.State.EffectKind == PowerupKind.Leap && S.HumanTurn)
        {
            <button class="perk fire-btn" data-action="leap-stop" @onclick="S.LeapStop">
                <span class="pi">@Icons.Svg("checker")</span><span class="pl">Stop</span>
            </button>
        }
        @if (S.HasDetonate)
        {
            <button class="perk boom-btn" data-action="detonate" @onclick="S.PreviewBomb">
                <span class="pi">@Icons.Svg("bomb")</span><span class="pl">Detonate</span>
            </button>
        }
        @if (S.Mode == InputMode.BombPreview)
        {
            <button class="perk boom-btn" data-action="bomb-confirm" @onclick="S.Detonate">
                <span class="pi">@Icons.Svg("bomb")</span><span class="pl">Confirm blast</span>
            </button>
        }
        @if (S.Mode != InputMode.Normal && S.Mode != InputMode.Promotion)
        {
            <button class="perk ghost" @onclick="S.Cancel"><span class="pl">Cancel</span></button>
        }
        @if (S.HintAvailable)
        {
            @if (S.HintsLeft > 0)
            {
                <button class="perk hint-btn" data-action="hint" @onclick="S.Hint">
                    <span class="pi">@Icons.Svg("spark")</span><span class="pl">Hint</span><span class="pn" data-testid="hints-left">@S.HintsLeft</span>
                </button>
            }
            else if (adsAvailable)
            {
                <button class="perk hint-btn" data-action="hint-ad" disabled="@adBusy" @onclick="BuyHint">
                    <span class="pi">@Icons.Svg("spark")</span><span class="pl">@(adBusy ? "Loading ad..." : "Watch an ad for a hint")</span>
                </button>
            }
            else
            {
                <button class="perk hint-btn" data-action="hint" disabled title="No hints left this game">
                    <span class="pi">@Icons.Svg("spark")</span><span class="pl">No hints left</span>
                </button>
            }
        }
        @HistoryNav
        @if (S.CanResign)
        {
            <button class="perk ghost resign-btn" data-action="resign" @onclick="() => showResign = true">
                <span class="pi">@Icons.Svg("flag")</span><span class="pl">Resign</span>
            </button>
        }
        }
    </section>

    @if (showDebug)
    {
        <section class="debug" data-testid="debug">
            <div class="debug-head"><b>DEBUG</b><small>@(S.DebugHint == "" ? "Pick a tool, then tap the board" : S.DebugHint)</small>
                <button class="x" aria-label="Close debug" @onclick="CloseDebug">x</button></div>
            <div class="debug-row"><span>Watch</span>
                <button class="dbtn @(opt.Watch ? "on" : "")" data-dwatch="toggle" @onclick="ToggleWatch">@(opt.Watch ? "Back to playing" : "AI vs AI")</button>
            </div>
            <div class="debug-row"><span>Cards to @(S.DebugCardsToRival ? "rival" : "you")</span>
                <button class="dbtn @(S.DebugCardsToRival ? "on" : "")" data-dcards="side" @onclick="S.DebugToggleCardSide">@(S.DebugCardsToRival ? "Rival" : "You")</button>
                @foreach (var k in CardKinds)
                {
                    var kk = k;
                    <button class="dbtn" data-dcard="@kk.ToString().ToLowerInvariant()" @onclick="() => S.DebugGiveCard(kk)">@Names.CardShort(kk)</button>
                }
                <button class="dbtn warn" data-dcards="clear" @onclick="S.DebugClearBags">Clear bags</button>
            </div>
            <div class="debug-row"><span>Power a piece</span>
                @foreach (var (label, kind, times) in DebugBuffs)
                {
                    var kk = kind; var tt = times;
                    <button class="dbtn @(S.DebugArmed == DebugTool.Buff && S.DebugKind == kk && S.DebugTimes == tt ? "on" : "")" data-dbuff="@(kk.ToString().ToLowerInvariant() + (tt > 1 ? "2" : ""))" @onclick="() => S.DebugArm(DebugTool.Buff, kk, tt)">@label</button>
                }
                <button class="dbtn warn @(S.DebugArmed == DebugTool.Unbuff ? "on" : "")" data-dbuff="strip" @onclick="() => S.DebugArm(DebugTool.Unbuff)">Strip</button>
                <button class="dbtn @(S.DebugArmed == DebugTool.Stun ? "on" : "")" data-dbuff="stun" @onclick="() => S.DebugArm(DebugTool.Stun)">Stun</button>
            </div>
            <div class="debug-row"><span>Drop square</span>
                <button class="dbtn @(S.DebugArmed == DebugTool.Square && S.DebugKind == PowerupKind.None ? "on" : "")" data-dsquare="hidden" @onclick="() => S.DebugArm(DebugTool.Square, PowerupKind.None)">? Mystery</button>
                @foreach (var k in DebugSquares)
                {
                    var kk = k;
                    <button class="dbtn @(S.DebugArmed == DebugTool.Square && S.DebugKind == kk ? "on" : "")" data-dsquare="@kk.ToString().ToLowerInvariant()" @onclick="() => S.DebugArm(DebugTool.Square, kk)">@Names.Name(kk)</button>
                }
                <button class="dbtn @(S.DebugArmed == DebugTool.Portal ? "on" : "")" data-dsquare="portal" @onclick="() => S.DebugArm(DebugTool.Portal)">Teleporters</button>
                <button class="dbtn warn @(S.DebugArmed == DebugTool.Clear ? "on" : "")" data-dsquare="clear" @onclick="() => S.DebugArm(DebugTool.Clear)">Remove</button>
            </div>
            <div class="debug-row"><span>Board</span>
                <button class="dbtn" data-dboard="spawn" @onclick="S.DebugSpawn">Spawn pair</button>
                <button class="dbtn warn" data-dboard="clear" @onclick="S.DebugClearBoard">Clear all powers</button>
            </div>
            <div class="debug-row"><span>Scramble</span>
                <button class="dbtn" data-dboard="scramble-early" @onclick="() => S.DebugScramble(16)">Early (16)</button>
                <button class="dbtn" data-dboard="scramble-mid" @onclick="() => S.DebugScramble(40)">Middle (40)</button>
                <button class="dbtn" data-dboard="scramble-late" @onclick="() => S.DebugScramble(80)">Late (80)</button>
            </div>
            <div class="debug-row"><span>Progress</span>
                <button class="dbtn" data-dprog="max" @onclick="() => DebugXp(Progression.XpForLevel(Progression.MaxLevel))">Max level</button>
                <button class="dbtn" data-dprog="plus" @onclick="() => DebugXp(profile.Xp + 100)">+100 XP</button>
                <button class="dbtn" data-dprog="nextday" @onclick="() => today++">Next day</button>
                <button class="dbtn warn" data-dprog="reset" @onclick="() => DebugXp(0, true)">Reset profile</button>
            </div>
        </section>
    }

    <div class="status @(S.InCheck && !S.GameOver ? "warn" : "")" data-testid="status">@S.Status</div>
    @if (S.HintText != "")
    {
        <div class="hint-line" data-testid="hint-text">@S.HintText</div>
    }

    @if (S.Inspect >= 0 && !S.Reviewing && S.Tutorial == null && !S.State.Cells[S.Inspect].IsEmpty)
    {
        var ip = S.State.Cells[S.Inspect];
        string rivalWord = ip.Side == Side.White ? "red" : "blue";   // White is drawn blue, Black red
        string? miniHint = S.HumanTurn && ip.Side == S.HumanSide && inspectMore != S.Inspect
            ? (S.HoldsFireball ? $"Tap Fireball, then a {rivalWord} piece" : S.HoldsLeap ? $"Tap Checkers, then a {rivalWord} piece" : S.HasDetonate ? "Tap Detonate to blow it up" : null)
            : null;
        @if (miniHint != null)
        {
            <div class="inspect mini" data-testid="inspect-mini">
                <b>@miniHint</b>
                <button class="demo-btn" data-action="inspect-more" @onclick="() => inspectMore = S.Inspect">More</button>
                <button class="x" aria-label="Close" @onclick="S.CloseInspect">x</button>
            </div>
        }
        else
        {
        <div class="inspect" data-testid="inspect">
            <div class="inspect-head">
                <b>@InspectTitle(ip)</b>
                <button class="x" aria-label="Close" @onclick="S.CloseInspect">x</button>
            </div>
            @foreach (var flag in new[] { Buff.DoubleMove, Buff.TripleMove, Buff.Ghost, Buff.Poison, Buff.Armor, Buff.Fireball, Buff.Leap, Buff.SmallBomb, Buff.BigBomb })
            {
                if (!ip.Has(flag)) { continue; }
                var kind = Names.ForBuff(flag);
                <div class="inspect-row">
                    <span class="gi buff">@Icons.Svg(Names.Icon(kind))</span>
                    <span>
                        <b>@Names.TierName(kind, ip.Tier)</b>
                        @(flag == Buff.Armor
                            ? $"Can't be captured for {ip.ArmorTurns} more opponent {(ip.ArmorTurns == 1 ? "turn" : "turns")}."
                            : flag == Buff.Ghost
                            ? $"Passes through pieces for {ip.GhostTurns} more {(ip.GhostTurns == 1 ? "move" : "moves")}."
                            : Names.Short(kind, ip.Tier))
                    </span>
                    <button class="demo-btn" data-demo="@kind.ToString().ToLowerInvariant()" @onclick="() => S.ShowTutorial(kind)">Demo</button>
                </div>
            }
            @if (ip.IsStunned)
            {
                <div class="inspect-row">
                    <span class="gi perk">@Icons.Svg("star")</span>
                    <span>
                        <b>Frozen</b>
                        @($"Can't move for {ip.StunTurns} more {(ip.StunTurns == 1 ? "turn" : "turns")}.")
                    </span>
                    <button class="demo-btn" data-demo="stun" @onclick="() => S.ShowTutorial(PowerupKind.Stun)">Demo</button>
                </div>
            }
        </div>
        }
    }
</div>

@if (S.InspectSquare >= 0 && !S.Reviewing && S.Tutorial == null && S.State.Portal[S.InspectSquare] && !S.State.Mystery[S.InspectSquare])
{
    <div class="inspect sqinfo" data-testid="inspect-square" data-content="portal">
        <div class="inspect-head">
            <b>Teleporter</b>
            <button class="x" aria-label="Close" @onclick="S.CloseInspect">x</button>
        </div>
        <div class="inspect-row">
            <span class="gi perk">@Icons.Svg("portal")</span>
            <span>@Names.PortalDesc</span>
        </div>
    </div>
}
else if (S.InspectSquare >= 0 && !S.Reviewing && S.Tutorial == null && S.State.Mystery[S.InspectSquare])
{
    var sk = (PowerupKind)S.State.Content[S.InspectSquare];
    <div class="inspect sqinfo" data-testid="inspect-square" data-content="@ContentName(S.InspectSquare)">
        <div class="inspect-head">
            <b>@(sk == PowerupKind.None ? "Mystery square" : Names.Name(sk))</b>
            <button class="x" aria-label="Close" @onclick="S.CloseInspect">x</button>
        </div>
        <div class="inspect-row">
            <span class="gi @(sk != PowerupKind.None && PowerupInfo.IsPerk(sk) ? "perk" : "buff")">@(sk == PowerupKind.None ? Icons.Svg("question") : Icons.Svg(Names.Icon(sk)))</span>
            <span>@(sk == PowerupKind.None ? "Land a piece here to find out what it holds. Squares appear in matching pairs." : Names.Desc(sk))</span>
            @if (sk != PowerupKind.None)
            {
                <button class="demo-btn" data-demo="@sk.ToString().ToLowerInvariant()" @onclick="() => S.ShowTutorial(sk)">Demo</button>
            }
        </div>
    </div>
}

@if (S.Tutorial is PowerupKind tk)
{
    <div class="tutorial" data-testid="tutorial" data-kind="@tk.ToString().ToLowerInvariant()">
        <DemoBoard Kind="tk" />
        <div class="tut-text">
            <div class="tut-title">
                <span class="gi @(PowerupInfo.IsPerk(tk) ? "perk" : "buff")">@Icons.Svg(Names.Icon(tk))</span>
                <b>@TutorialTitle(tk)</b>
            </div>
            <p>@TutorialText(tk)</p>
            <label class="chk"><input type="checkbox" data-testid="tut-off" @bind="S.DontShowAgain" /> Don't show tutorials again</label>
            <button class="btn primary tut-ok" data-action="tutorial-ok" @onclick="S.DismissTutorial">Got it</button>
        </div>
    </div>
}

@if (S.PickupPending && S.HumanTurn)
{
    var kind = S.State.PendingKind;
    <div class="modal" data-testid="pickup">
        <div class="card pop">
            <div class="kicker">Mystery square!</div>
            <div class="big-icon @(PowerupInfo.IsPerk(kind) ? "perk" : "buff")">@Icons.Svg(Names.Icon(kind))</div>
            <h2>@Names.Name(kind)</h2>
            <p>@Names.Desc(kind)</p>
            @if (S.PickupTutorial)
            {
                <DemoBoard Kind="kind" />
                <label class="chk"><input type="checkbox" data-testid="tut-off" @bind="S.DontShowAgain" /> Don't show tutorials again</label>
            }
            <div class="row">
                <button class="btn primary" data-action="keep" @onclick="S.KeepPickup">Keep it</button>
                @if (S.Perk(S.Turn, PowerupKind.Reroll) > 0)
                {
                    <button class="btn" data-action="reroll" @onclick="S.RerollPickup">Reroll (@S.Perk(S.Turn, PowerupKind.Reroll))</button>
                }
            </div>
        </div>
    </div>
}

@if (S.Mode == InputMode.Promotion)
{
    <div class="modal" data-testid="promotion">
        <div class="card pop">
            <div class="kicker">Promote your pawn</div>
            <div class="row promo">
                @foreach (var a in S.PromoChoices)
                {
                    var choice = a;
                    <button class="btn promo-btn" data-promo="@((PieceType)choice.Aux)" @onclick="() => S.Choose(choice)">
                        <PieceSvg Type="(PieceType)choice.Aux" Side="S.Turn" />
                    </button>
                }
            </div>
            <button class="btn ghost" @onclick="S.Cancel">Cancel</button>
        </div>
    </div>
}

@if (S.GameOver && !S.Busy && !S.Reviewing && S.Puzzle == null)
{
    <div class="modal" data-testid="gameover">
        <div class="card pop result @ResultClass">
            <div class="kicker">@(Perfect ? "PERFECT!" : S.Status)</div>
            @if (reward is MatchReward lvr && lvr.NewLevel > lvr.OldLevel && xpAnimDone)
            {
                @* a level-up is the headline; the result steps back to a smaller line above it *@
                <div class="res-small">@ResultTitle</div>
                <h1 class="lvl-big" data-testid="levelup" @key="@("lv" + lvr.NewLevel)">LEVEL UP!</h1>
                <div class="lvl-sub">You reached level @lvr.NewLevel</div>
            }
            else
            {
                <h1>@ResultTitle</h1>
            }
            <p>@ResultText</p>
            @if (reward is MatchReward rw)
            {
                <div class="reward" data-testid="reward">
                    <div class="xp-line"><b>+@rw.XpGained XP</b>
                        <button class="link-btn" data-action="xp-details" @onclick="() => showXpDetail = !showXpDetail">@(showXpDetail ? "Hide details" : "Details")</button></div>
                    @if (showXpDetail)
                    {
                        <div class="xp-detail" data-testid="xp-detail">@string.Join(" · ", rw.Breakdown.Select(b => $"{b.Key} {b.Value}"))</div>
                    }
                    <div class="xpbar @(animSnap ? "snap" : "")" data-testid="xp-anim"><i style="width:@(xpAnimDone ? XpPercent(profile) : animPct)%"></i></div>
                    @if (S.HintsUsed > 0) { <div class="lv-line" data-testid="hint-note">Hints used: @S.HintsUsed (XP x@(HintPolicy.XpScale(S.HintsUsed).ToString("0.0")))</div> }
                    @if (!xpAnimDone)
                    {
                        <div class="lv-line">Level @animLevel</div>
                    }
                    else if (rw.NewLevel > rw.OldLevel)
                    {
                                                <div class="lv-line">@(profile.Level < Progression.MaxLevel ? $"{Progression.XpForLevel(profile.Level + 1) - profile.Xp} XP to level {profile.Level + 1}" : "Max level")</div>
                        @if ((rw.NewPowerups.Count > 0 || rw.NewTeleporters) && newUnlocks.Count == 0)
                        {
                            <div class="unlocks">Unlocked: @string.Join(", ", rw.NewPowerups.Select(Names.Name).Concat(rw.NewTeleporters ? new[] { "Teleporters" } : Array.Empty<string>()))</div>
                        }
                        @* the full explanation is in the spotlight pop-up; the card just lists what was earned *@
                        @if (newUnlocks.Count > 0)
                        {
                            <div class="unlock-line" data-testid="unlock-line">
                                <span class="ul-label">Unlocked</span>
                                @foreach (var nm in UnlockNames(newUnlocks))
                                {
                                    <span class="ul-chip">@nm</span>
                                }
                                <button class="link-btn" data-action="show-unlocks" @onclick="() => spotlightOpen = true">Show me</button>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="lv-line">Level @profile.Level@(profile.Level < Progression.MaxLevel ? $" · {Progression.XpForLevel(profile.Level + 1) - profile.Xp} XP to level {profile.Level + 1}" : " · max")</div>
                    }
                    @if (rw.NewTrophies.Count > 0)
                    {
                        <div class="trophy-row" data-testid="trophy-row">
                            @foreach (var t in rw.NewTrophies)
                            {
                                <span class="trophy-chip" data-trophy-new="@t.Name" title="@t.Description"><i>@Icons.Svg("star")</i>@t.Name</span>
                            }
                        </div>
                    }
                </div>
            }
            @if (reward is MatchReward adrw && adsAvailable && !adrw.Doubled && adrw.XpGained > 0)
            {
                <button class="btn ghost" data-action="double-xp" disabled="@adBusy" @onclick="DoubleXp">@(adBusy ? "Loading ad..." : "Watch an ad: double XP")</button>
            }
            <button class="btn primary" data-action="again" disabled="@adBusy" @onclick="StartNewAsync">Play again</button>
            @if (S.CanReview)
            {
                <button class="btn ghost" data-action="review-game" @onclick="() => S.ReviewStep(-1)">Review the game</button>
                <button class="btn yellow" data-action="open-clip" @onclick="OpenClip">Watch Replay!</button>
            }
            @if (MateScripts.Count > 0)
            {
                <button class="btn ghost" data-action="why-mate" @onclick="() => showMateWhy = true">Why is this mate?</button>
            }
        </div>
    </div>
}

@if (showMateWhy && MateScripts.Count > 0)
{
    <MateWhy Scripts="MateScripts" OnClose="() => showMateWhy = false" />
}

@if (spotlightOpen && newUnlocks.Count > 0)
{
    <UnlockSpotlight Items="newUnlocks" OnClose="() => { spotlightOpen = false; unseenUnlocks = false; }" OnTry="TryPreset" />
}

@if (showResign && S.CanResign)
{
    <div class="modal" data-testid="resign-confirm" @onclick="() => showResign = false">
        <div class="modal-card" @onclick:stopPropagation="true">
            <h2>Resign?</h2>
            <p>You'll lose this game.</p>
            <div class="row">
                <button class="btn primary" data-action="resign-yes" @onclick="() => { showResign = false; S.Resign(); }">Resign</button>
                <button class="btn ghost" data-action="resign-no" @onclick="() => showResign = false">Keep playing</button>
            </div>
        </div>
    </div>
}

@if (S.Puzzle is PuzzleDef rz && S.PuzzleOutcome != PuzzleResult.None && !S.Busy)
{
    <div class="modal" data-testid="puzzle-result">
        <div class="card pop result @(S.PuzzleOutcome == PuzzleResult.Solved ? "win" : "lose")">
            <div class="kicker">@rz.Title</div>
            @if (S.PuzzleOutcome == PuzzleResult.Solved && puzzleReward is MatchReward lpr && lpr.NewLevel > lpr.OldLevel)
            {
                <div class="res-small">SOLVED!</div>
                <h1 class="lvl-big" data-testid="levelup">LEVEL UP!</h1>
                <div class="lvl-sub">You reached level @lpr.NewLevel</div>
            }
            else
            {
                <h1>@(S.PuzzleOutcome == PuzzleResult.Solved ? "SOLVED!" : "NOT QUITE")</h1>
            }
            @if (S.PuzzleOutcome == PuzzleResult.Solved)
            {
                <p>Checkmate in @S.PuzzleMoves of @rz.MaxMoves @(rz.MaxMoves == 1 ? "move" : "moves").</p>
                @if (puzzleReward is MatchReward pr)
                {
                    <div class="reward" data-testid="puzzle-reward">
                        <div class="xp-line"><b>+@pr.XpGained XP</b></div>
                        <div class="xp-detail">@string.Join(" · ", pr.Breakdown.Select(b => $"{b.Key} {b.Value}"))</div>
                        <div class="streak-line" data-testid="streak">Daily streak: <b>@profile.DailyStreak</b> @(profile.DailyStreak == 1 ? "day" : "days")</div>
                        @foreach (var t in pr.NewTrophies)
                        {
                            <div class="trophy-new" data-trophy-new="@t.Name"><span>@Icons.Svg("star")</span><b>@t.Name</b><small>@t.Description</small></div>
                        }
                    </div>
                }
                else
                {
                    <p class="fine">Already counted today. Come back tomorrow for a new puzzle.</p>
                }
                <button class="btn yellow" data-action="share" @onclick="SharePuzzle">Share replay</button>
            }
            else
            {
                <p>@(S.Result == GameResult.Ongoing ? "You ran out of moves." : "The game ended without your checkmate.") Give it another go.</p>
                <button class="btn primary" data-action="puzzle-retry-result" @onclick="RetryPuzzle">Retry</button>
            }
            <button class="btn ghost" data-action="puzzle-quit-result" @onclick="QuitPuzzle">Back to game</button>
        </div>
    </div>
}

@if (showDaily)
{
    var dp = Daily.PuzzleFor(today);
    bool done = Daily.SolvedToday(profile, today);
    <div class="modal" data-testid="daily" @onclick="() => showDaily = false">
        <div class="card help" @onclick:stopPropagation="true">
            <div class="kicker">Daily challenge · @DateTime.UnixEpoch.AddDays(today).ToString("MMM d")</div>
            <div class="streak-big" data-testid="daily-streak"><span class="flame">@Icons.Svg("fire")</span><b>@Daily.ActiveStreak(profile, today)</b><small>day streak · best @profile.BestStreak</small></div>
            <h2 class="daily-title">@dp.Title</h2>
            <p>Checkmate in <b>@dp.MaxMoves</b> @(dp.MaxMoves == 1 ? "move" : "moves"). Difficulty: @(dp.Tier == 1 ? "easy" : dp.Tier == 2 ? "medium" : "hard").</p>
            <p class="fine">@dp.Hint</p>
            @if (done)
            {
                <p class="solved-today" data-testid="daily-done">Solved today. A new puzzle arrives tomorrow.</p>
                <button class="btn" data-action="daily-play" @onclick="StartPuzzle">Play again for fun</button>
            }
            else
            {
                <p class="fine">Solve it for @Daily.XpForStreak(Daily.ActiveStreak(profile, today) + 1) XP (more with a longer streak).</p>
                <button class="btn primary" data-action="daily-play" @onclick="StartPuzzle">Play</button>
            }
            <button class="btn ghost" data-action="daily-close" @onclick="() => showDaily = false">Close</button>
        </div>
    </div>
}

@if (showNew)
{
    <div class="modal" data-testid="newgame" @onclick="() => showNew = false">
        <div class="card newgame" @onclick:stopPropagation="true">
            <div class="kicker">Choose your fight</div>
            <div class="opt-label">Opponent</div>
            <div class="seg six">
                @foreach (var lv in Ai.Ladder.Append(0))
                {
                    int level = lv;
                    <button class="@Seg(selAi == level)" data-ai="@level" @onclick="() => selAi = level">@Ai.LevelName(level)</button>
                }
            </div>
            @if (selAi > 0)
            {
                <div class="opt-label">Play as</div>
                <div class="seg three" data-testid="play-as">
                    <button class="@Seg(selPlayAs == "white")" data-side="white" @onclick='() => selPlayAs = "white"'>White</button>
                    <button class="@Seg(selPlayAs == "black")" data-side="black" @onclick='() => selPlayAs = "black"'>Black</button>
                    <button class="@Seg(selPlayAs == "random")" data-side="random" @onclick='() => selPlayAs = "random"'>Random</button>
                </div>
            }
            <button class="btn ghost small more-toggle" data-action="more-options" @onclick="() => showMoreOptions = !showMoreOptions">@(showMoreOptions ? "Fewer options" : "More options")</button>
            @if (!showMoreOptions)
            {
                <div class="opt-summary" data-testid="opt-summary">@OptionSummary</div>
            }
            else
            {
                <div class="more-options" data-testid="more-options">
            <div class="opt-label">Powerup squares</div>
            <div class="seg">
                <button class="@Seg(selMode == SquareMode.Revealed)" data-mode="revealed" @onclick="() => selMode = SquareMode.Revealed">
                    <b>Revealed</b><small>See what each square holds. A few stay a mystery.</small>
                </button>
                <button class="@Seg(selMode == SquareMode.Mystery)" data-mode="mystery" @onclick="() => selMode = SquareMode.Mystery">
                    <b>Mystery</b><small>Every square is a "?" until you land on it.</small>
                </button>
            </div>
            @if (PresetChoices().Any(x => x.id != Presets.Classic && Presets.Available(x.id, EffectiveLevel)))
            {
                <div class="opt-label">Rules</div>
                <div class="opt-chips" data-testid="preset-chips">
                    @foreach (var pr in PresetChoices())
                    {
                        var choice = pr;
                        bool open = Presets.Available(choice.id, EffectiveLevel);
                        @if (open)
                        {
                            <button class="@Seg(selPreset == choice.id) chip-btn" data-preset="@choice.id" title="@choice.blurb" @onclick="() => selPreset = choice.id">
                                <b>@choice.name</b>
                            </button>
                        }
                    }
                </div>
                @if (selPreset != Presets.Classic && Presets.Available(selPreset, EffectiveLevel))
                {
                    <div class="preset-blurb" data-testid="preset-blurb">@PresetBlurb(selPreset) <em>Half XP.</em></div>
                }
                @if (selPreset == Presets.Custom && Presets.Available(selPreset, EffectiveLevel))
                {
                    <button class="btn ghost small" data-action="customize" @onclick="() => showCustom = true">Customize powerups</button>
                }
            }
            @if (Presets.FrequencyAvailable(EffectiveLevel))
            {
                <div class="opt-label">Square frequency</div>
                <div class="opt-chips" data-testid="freq-chips">
                    @foreach (var fq in new[] { Frequency.Rare, Frequency.Normal, Frequency.Frequent, Frequency.Chaos })
                    {
                        var f = fq;
                        bool open = Presets.FrequencyAvailable(EffectiveLevel);
                        <button class="@Seg(selFreq == f && (open || f == Frequency.Normal)) chip-btn @(open || f == Frequency.Normal ? "" : "locked")" data-freq="@((int)f)" disabled="@(!open && f != Frequency.Normal)" @onclick="() => selFreq = f">
                            <b>@Presets.FrequencyName(f)</b>
                            @if (!open && f != Frequency.Normal) { <small>Level @Presets.FrequencyLevel</small> }
                        </button>
                    }
                </div>
            }
            <div class="opt-label">Effects</div>
            <div class="seg">
                <button class="@Seg(selDrama)" data-drama="on" @onclick="() => selDrama = true">
                    <b>Dramatic</b><small>Slashes, hit-stop and big callouts on captures.</small>
                </button>
                <button class="@Seg(!selDrama)" data-drama="off" @onclick="() => selDrama = false">
                    <b>Calm</b><small>Quick and quiet. Faster to play.</small>
                </button>
            </div>
                </div>
                @if (NextUnlockHint != "")
                {
                    <div class="opt-summary">@NextUnlockHint</div>
                }
            }
            <div class="row newgame-row">
                <button class="btn primary" data-action="start-game" @onclick="StartFromSheet">FIGHT!</button>
                <button class="btn ghost" data-action="cancel-new" @onclick="() => showNew = false">Cancel</button>
            </div>
        </div>
    </div>
}


@if (showClip)
{
    <div class="modal" data-testid="clip-sheet">
        <div class="card clip-sheet" @onclick:stopPropagation="true">
            <div class="kicker">Replay clip</div>
            <canvas id="clipCanvas" class="clip-canvas" width="720" height="1280"></canvas>
            <div class="clip-len">
                <button class="rbtn" data-action="clip-shorter" disabled="@(clipPlies <= 1 || clipBusy)" @onclick="() => SetClipPlies(clipPlies - 1)" aria-label="Show fewer moves">@Icons.Svg("prev")</button>
                <span data-testid="clip-len">Last <b>@clipPlies</b> @(clipPlies == 1 ? "move" : "moves") <small>of @clipAvail</small></span>
                <button class="rbtn" data-action="clip-longer" disabled="@(clipPlies >= clipAvail || clipBusy)" @onclick="() => SetClipPlies(clipPlies + 1)" aria-label="Show more moves">@Icons.Svg("next")</button>
            </div>
            @if (clipMsg != "") { <div class="clip-msg" data-testid="clip-msg">@clipMsg</div> }
            @if (clipReady && !clipBusy) { <div class="clip-hint">Share opens your phone's share sheet: TikTok, Instagram, Messages and more.</div> }
            <div class="row newgame-row">
                <button class="btn ghost" data-action="clip-replay" disabled="@clipBusy" @onclick="PlayClip">Replay</button>
                @if (!clipReady)
                {
                    <button class="btn yellow" data-action="clip-share" disabled="@clipBusy" @onclick="RenderClip">@(clipBusy ? "Rendering..." : "Make video to share")</button>
                }
                else
                {
                    <button class="btn yellow" data-action="clip-send" @onclick="SendClip">Share video</button>
                    <button class="btn" data-action="clip-save" @onclick="SaveClip">Save</button>
                }
                <button class="btn ghost" data-action="clip-close" disabled="@clipBusy" @onclick="CloseClip">Close</button>
            </div>
        </div>
    </div>
}

@if (showCustom)
{
    <div class="modal" data-testid="custom-sheet" @onclick="() => showCustom = false">
        <div class="card custom-sheet" @onclick:stopPropagation="true">
            <div class="kicker">Custom powerups</div>
            <div class="custom-list">
                @{ var kinds = Presets.CustomKinds(); }
                @for (int i = 0; i < kinds.Count; i++)
                {
                    int idx = i;
                    var kind = kinds[i];
                    int v = Presets.CustomLevelOf(selCustom, idx);
                    <div class="custom-row" data-custom="@kind.ToString().ToLowerInvariant()">
                        <span>@Names.Name(kind)</span>
                        <button class="chip-btn on" data-level="@v" @onclick="() => selCustom = Presets.SetCustom(selCustom, idx, (Presets.CustomLevelOf(selCustom, idx) + 1) % 4)">@(new[] { "Off", "Low", "Normal", "High" }[v])</button>
                    </div>
                }
            </div>
            <div class="row newgame-row">
                <button class="btn primary" data-action="custom-done" @onclick="() => showCustom = false">Done</button>
                <button class="btn ghost" data-action="custom-reset" @onclick="() => selCustom = Presets.DefaultCustom()">Reset</button>
            </div>
        </div>
    </div>
}

@if (showProfile)
{
    <div class="modal" data-testid="profile" @onclick="() => showProfile = false">
        <div class="card help" @onclick:stopPropagation="true">
            <div class="kicker">Your profile</div>
            <div class="xp-line"><b>Level @profile.Level</b><small>@profile.Xp XP</small></div>
            <div class="xpbar"><i style="width:@(XpPercent(profile))%"></i></div>
            <div class="lv-line">@NextUnlockText</div>
            @if (nextUnlocks.Count > 0)
            {
                <button class="btn ghost small" data-action="preview-next" @onclick="() => showNextPreview = !showNextPreview">@(showNextPreview ? "Hide preview" : "Preview what's next")</button>
                @if (showNextPreview) { <UnlockStrip Items="nextUnlocks" Heading="@($"Coming at level {nextUnlockLevel}")" /> }
            }
            <div class="lv-line">Daily streak: @Daily.ActiveStreak(profile, today) (best @profile.BestStreak, @profile.DailySolved solved)</div>
            <ul class="stats">
                <li><b>@profile.Games</b><small>Games</small></li>
                <li><b>@profile.Wins</b><small>Wins</small></li>
                <li><b>@profile.Losses</b><small>Losses</small></li>
                <li><b>@profile.Draws</b><small>Draws</small></li>
                <li><b>@profile.Mates</b><small>Mates</small></li>
                <li><b>@profile.Captures</b><small>Captures</small></li>
                <li><b>@profile.Collected</b><small>Powerups</small></li>
                <li><b>@profile.FireballKills</b><small>Burned</small></li>
            </ul>
            <div class="opt-label">Trophies @(Trophies.All.Count(t => profile.Has(t))) / @Trophies.All.Length</div>
            <div class="trophies">
                @foreach (var t in Trophies.All)
                {
                    bool got = profile.Has(t);
                    <div class="trophy @(got ? "got" : "locked")" data-trophy="@t.Name" data-got="@(got ? "1" : "0")">
                        <span class="ti">@Icons.Svg(got ? "star" : "lock")</span>
                        <b>@t.Name</b>
                        <small>@t.Description</small>
                    </div>
                }
            </div>
            <button class="btn primary" @onclick="() => showProfile = false">Close</button>
        </div>
    </div>
}

@if (showMenu)
{
    <div class="start-menu" data-testid="start-menu">
        <canvas id="menuBg" class="sm-bg" aria-hidden="true"></canvas>
        <img class="sm-logo" src="img/logo.png" alt="Chess Fighter" />
