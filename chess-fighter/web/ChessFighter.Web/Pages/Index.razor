    string RulesLabel => S.Puzzle != null ? "" : Presets.Label(opt.Preset, opt.Freq, EffectiveLevel);

    string selPreset = Presets.Classic;
    Frequency selFreq = Frequency.Normal;
    string selCustom = Presets.DefaultCustom();
    bool showCustom;

    static IEnumerable<(string id, string name, string blurb, int level)> PresetChoices()
    {
        yield return (Presets.Classic, "Standard", "The normal powerup mix.", 1);
        foreach (var p in Presets.All) yield return (p.Id, p.Name, p.Blurb, p.UnlockLevel);
        yield return (Presets.Custom, "Custom", "Choose which powerups appear and how often.", Presets.CustomLevel);
    }

    static string PresetBlurb(string id) => Presets.Find(id)?.Blurb ?? "Choose which powerups appear and how often.";

    /// <summary>One line describing the current choices while the extra options are folded away.</summary>
    string OptionSummary => $"{(selMode == SquareMode.Mystery ? "Mystery squares" : "Revealed squares")} · {(Presets.Available(selPreset, EffectiveLevel) && selPreset != Presets.Classic ? PresetChoices().First(x => x.id == selPreset).name : "Standard rules")} · {(selDrama ? "Dramatic" : "Calm")} effects";

    /// <summary>"More ways to play unlock at level N", for the nearest locked rule variant.</summary>
    string NextUnlockHint
    {
        get
        {
            int next = 0;
            foreach (var c in PresetChoices()) if (c.level > EffectiveLevel && (next == 0 || c.level < next)) next = c.level;
            if (!Presets.FrequencyAvailable(EffectiveLevel) && (next == 0 || Presets.FrequencyLevel < next)) next = Presets.FrequencyLevel;
            return next == 0 ? "" : $"More ways to play unlock at level {next}.";
        }
    }

    static string Seg(bool on) => "seg-btn" + (on ? " on" : "");

    /// <summary>"fireball", "hidden" or "" for what a powerup square shows, for styling and tests.</summary>
    string ContentName(int sq)
    {
        if (!S.View.Mystery[sq]) return S.View.Portal[sq] ? "portal" : "";
        var k = (PowerupKind)S.View.Content[sq];
        return k == PowerupKind.None ? "hidden" : k.ToString().ToLowerInvariant();
    }

    public void Dispose()
    {
        if (S != null) { S.Changed = null; S.Sfx = null; S.Persist = null; }
    }

    // ---------- presentation helpers ----------

    string TileClass(int sq)
    {
        bool light = (Sq.File(sq) + Sq.Rank(sq)) % 2 == 1;
        var c = "sq " + (light ? "light" : "dark");
        var cell = S.View.Cells[sq];
        if (S.View.Mystery[sq]) c += " mystery powerup " + Names.SquareClass((PowerupKind)S.View.Content[sq]);
        else if (S.View.Portal[sq]) c += " portal powerup pu-portal";
        if (S.View.Boulders[sq]) c += " rock";
        if (sq == S.ViewLastFrom || sq == S.ViewLastTo) c += " last";
        if (sq == S.Selected) c += " selected";
        if (S.FinaleOn && (sq == S.FinaleKingSq || sq == S.FinaleAtkSq)) c += " fin-lit";
        if (sq == S.HintFrom || sq == S.HintTo) c += " hint";
        if (S.EffectPending && S.HumanTurn && S.EffectTargets.Contains(sq)) c += " aim";
        if (cardAim.Contains(sq))
        {
            if (S.ActiveCard == CardKind.MissileStrike)
            {
                // Four big blocks instead of 64 lit squares: only the outer edge of each quadrant is drawn.
                int f = Sq.File(sq) % 4, r = Sq.Rank(sq) % 4;
                c += " quad";
                if (f == 0) c += " ql";
                if (f == 3) c += " qr";
                if (r == 0) c += " qb";
                if (r == 3) c += " qt";
            }
            else c += " aim";
        }
        if (missileZone.Contains(sq)) c += " missile";
        if (S.CoachStep > 0 && S.CoachHighlights.Contains(sq)) c += " coachsq";
        if (S.Targets.Contains(sq))
        {
            bool enemy = !cell.IsEmpty && cell.Side != S.Turn;
            c += S.Mode == InputMode.Armed || S.Mode == InputMode.FireAim || S.Mode == InputMode.LeapAim
                ? " aim"
                : enemy ? " target cap" : " target";
        }
        if (S.Doomed.Contains(sq)) c += " doomed";
        if (S.Spared.Contains(sq)) c += " spared";
        if (S.BlastArea.Contains(sq)) c += " blast";
        if (S.InCheck && !S.Reviewing && cell.Type == PieceType.King && cell.Side == S.Turn && !S.GameOver) c += " check";
        return c;
    }

    HashSet<int> cardAim = new();
    HashSet<int> missileZone = new();

    /// <summary>Called once per render, before the board is drawn, so every tile can ask whether a card wants it tapped.</summary>
    string PrepCardAim()
    {
        cardAim = S.CardTargets.ToHashSet();
        missileZone = S.MissileZone;
        return S.ActiveCard == CardKind.None ? "" : S.ActiveCard.ToString();
    }

    static readonly CardKind[] CardKinds = Enumerable.Range(Cards.First, Cards.Last - Cards.First + 1).Select(i => (CardKind)i).ToArray();

    /// <summary>One side's card bag, visible to both players. The side to move can tap an at-will card to play it.</summary>
    RenderFragment Bag(Side side) => @<text>
        @{ var held = CardKinds.Where(k => S.State.CardCount(side, k) > 0).ToList(); }
        @if (held.Count > 0)
        {
            <section class="bag @(S.VsAi ? (side == S.RivalSide ? "opp" : "me") : (side == Side.Black ? "opp" : "me"))" data-testid="bag-@side.ToString().ToLowerInvariant()">
                @foreach (var k in held)
                {
                    var kind = k;
                    bool mine = S.HumanTurn && S.Turn == side && (!S.VsAi || side == S.HumanSide) && !CardInfo.IsReaction(kind);
                    <button class="card-item @(CardInfo.IsReaction(kind) ? "react" : "will") @(S.SelectedCard == kind ? "on" : "")" disabled="@(!mine)"
                            data-card="@kind.ToString().ToLowerInvariant()" title="@Names.CardDesc(kind)" @onclick="() => S.SelectCard(kind)">
                        <span class="ci">@Icons.Svg(Names.CardIcon(kind))</span>
                        <span class="cl">@Names.CardShort(kind)</span>
                        <span class="cc">@S.State.CardCount(side, kind)</span>
                    </button>
                }
            </section>
        }
    </text>;

    /// <summary>Fighting-game "health": the share of the starting material (39 points) a side still has.</summary>
    int Hp(Side side)
    {
        // K.O.: the side that lost the game has an empty bar, whatever material it still had.
        if (S.GameOver && S.Winner() is Side winner && winner != side) return 0;
        int total = 0;
        foreach (var p in S.ViewPieces)
        {
            if (p.Side != side || p.Dying) continue;
            total += p.Type switch { PieceType.Pawn => 1, PieceType.Knight => 3, PieceType.Bishop => 3, PieceType.Rook => 5, PieceType.Queen => 9, _ => 0 };
        }
        return Math.Clamp(total * 100 / 39, 0, 100);
    }

    RenderFragment InvChips(Side side) => @<text>
        @foreach (var k in ChipKinds)
        {
            int n = S.Perk(side, k.Kind);
            <span class="chip @(n == 0 ? "zero" : "")" title="@k.Tip" data-chip="@k.Kind.ToString().ToLowerInvariant()">@Icons.Svg(Names.Icon(k.Kind))<b>@n</b></span>
        }
    </text>;

    string InspectTitle(Piece p)
    {
        string owner = S.VsAi ? (p.Side == S.HumanSide ? "Your" : "Rival") : (p.Side == Side.White ? "White" : "Black");
        return owner + " " + p.Type;
    }

    string DrawText => S.ResultReason switch
    {
        "Stalemate" => "The player to move has no legal move and is not in check.",
        "Only kings left" => "Nothing is left to checkmate with.",
        "50-move rule" => "Fifty moves without a capture or pawn move.",
        "Move limit reached" => "The game ran out of moves.",
        _ => "Nobody could finish it.",
    };

    string ResultClass => S.Result == GameResult.Draw ? "draw" : (S.VsAi && S.Winner() == S.RivalSide ? "lose" : "win");

    string ResultTitle => S.Result == GameResult.Draw
        ? "DRAW GAME"
        : S.VsAi ? (S.Winner() == S.HumanSide ? "YOU WIN" : "YOU LOSE")
        : (S.Winner() == Side.White ? "P1 WINS" : "P2 WINS");

    static readonly string[] WinQuotes =
    {
        "Not bad! Your endgame is fierce.",
        "A clean finish. The crowd goes wild!",
        "That king never saw it coming.",
        "Checkmate! What a K.O.!",
    };

    static readonly string[] LoseQuotes =
    {
        "You must tighten your defence to stand a chance!",
        "Shake it off. The rematch is one tap away.",
        "Learn from this one and come back stronger!",
    };

    string ResultText => S.Result == GameResult.Draw
        ? DrawText
        : S.VsAi
            ? (S.Winner() == S.HumanSide ? WinQuotes[S.Moves % WinQuotes.Length] : LoseQuotes[S.Moves % LoseQuotes.Length])
            : "Checkmate.";

    /// <summary>"PERFECT!" when the winner finished with every point of material, like a no-damage round.</summary>
    bool Perfect => S.Result != GameResult.Draw && S.Winner() is Side w && Hp(w) >= 100;
}
