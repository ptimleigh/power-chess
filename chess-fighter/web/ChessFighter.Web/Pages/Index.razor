    // ---------- unlock previews ----------

    List<UnlockItem> newUnlocks = new();
    bool unseenUnlocks, showNextPreview;
    int nextUnlockLevel => Unlocks.NextUnlockLevel(profile.Level);
    List<UnlockItem> nextUnlocks => nextUnlockLevel == 0 ? new() : Unlocks.AtLevel(nextUnlockLevel);

    void RefreshUnlocks()
    {
        newUnlocks = reward != null && reward.NewLevel > reward.OldLevel ? Unlocks.Between(reward.OldLevel, reward.NewLevel) : new();
        if (newUnlocks.Count > 0) unseenUnlocks = true;
    }

    /// <summary>Short names for what a level-up unlocked: powers, upgrades, each new card, rule sets.</summary>
    static IEnumerable<string> UnlockNames(List<UnlockItem> items)
    {
        foreach (var it in items)
        {
            if (it.Type == UnlockType.Powerup || it.Type == UnlockType.Transforms) yield return Names.Name(it.Kind);
            else if (it.Type == UnlockType.Cards) { foreach (var c in it.CardKinds) yield return Names.CardName(c); }
            else yield return it.Name ?? "New";
        }
    }

    void TryPreset(string id)
    {
        opt.Preset = id;
        OpenNew();
