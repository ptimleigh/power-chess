    }

    // ---------- replay clip ----------

    bool showResign;
    bool showMateWhy;

    // The "Why is this mate?" animations, built once per finished game.
    int mateKey = -1;
    List<DemoScript> mateScripts = new();
    List<DemoScript> MateScripts
    {
        get
        {
            if (!S.GameOver || S.ResultReason != "Checkmate" || S.Reviewing) return new List<DemoScript>();
            int key = S.GameSerial * 10000 + S.Moves;
            if (key != mateKey)
            {
                mateKey = key;
                mateScripts = new List<DemoScript>();
                try
                {
                    foreach (var esc in MateExplainer.Explain(S.State))
                        mateScripts.Add(MateDemo.Build(S.State, esc, OwnerWord));
                }
                catch (Exception) { mateScripts = new List<DemoScript>(); }
            }
            return mateScripts;
        }
    }

    string OwnerWord(Side side) => S.VsAi ? (side == S.HumanSide ? "your" : "their") : (side == Side.White ? "White's" : "Black's");
    int inspectMore = -1;   // the square whose full info card the player asked for

    /// <summary>Back and forward arrows around the History button. Going back enters history mode, where the button reads "Back to game"; forward is dimmed while the game is up to date.</summary>
    RenderFragment HistoryNav => @<div class="hist-nav">
        <button class="rbtn" data-review="prev" aria-label="Back one move" disabled="@(!S.CanReview && !S.Reviewing || S.Reviewing && S.ReviewPosition <= 0)" @onclick="() => S.ReviewStep(-1)">@Icons.Svg("prev")</button>
        @if (S.Reviewing)
        {
            <button class="perk ghost hist-btn" data-action="exit-review" @onclick="S.ExitReview"><span class="pi">@Icons.Svg("history")</span><span class="pl">Back to game</span></button>
        }
        else
        {
            <button class="perk ghost hist-btn" data-action="review" disabled="@(!S.CanReview)" @onclick="() => S.ReviewTo(S.HistoryCount)"><span class="pi">@Icons.Svg("history")</span><span class="pl">History</span></button>
        }
        <button class="rbtn" data-review="next" aria-label="Forward one move" disabled="@(!S.Reviewing || S.ReviewPosition >= S.HistoryCount)" @onclick="() => S.ReviewStep(1)">@Icons.Svg("next")</button>
    </div>;
    bool showClip, clipBusy;
    int clipPlies, clipAvail;
    string clipMsg = "";

    // A replay opened from history mode covers the moves up to where you are looking, and ends with "to be continued" if the game goes on.
    GameHistory clipHistory = null!;
    bool clipOngoing;

    async Task OpenClip()
    {
        clipTitle = null;
        clipOngoing = S.Reviewing && S.ReviewPosition < S.HistoryCount;
        clipHistory = clipOngoing ? S.History.Prefix(S.ReviewPosition, 60) : S.History;
        clipAvail = ClipBuilder.Available(clipHistory);
        if (clipAvail == 0) return;
        clipPlies = Math.Min(6, clipAvail);
        clipMsg = "";
        showClip = true;
        clipReady = false;
        StateHasChanged();
        await Task.Delay(80);
        await PlayClip();
    }

    string? clipTitle;   // set for a puzzle replay ("DAILY: ..."); otherwise the title counts the moves
    string BuildClipJson() => ClipBuilder.Build(clipHistory, S.State, clipPlies, clipOngoing ? "" : S.ResultReason, clipOngoing ? GameResult.Ongoing : S.Result, S.VsAi,
        clipTitle ?? (clipPlies == 1 ? "THE LAST MOVE" : $"THE LAST {clipPlies} MOVES"), S.HumanSide);

    async Task PlayClip()
    {
        clipMsg = "";
        try { await JS.InvokeVoidAsync("pcclip.start", "clipCanvas", BuildClipJson(), !muted); }
        catch (Exception ex) { clipMsg = "Could not play the clip: " + ex.Message; }
    }

    async Task SetClipPlies(int n)
    {
        clipPlies = Math.Clamp(n, 1, clipAvail);
        clipReady = false;
        await PlayClip();
    }

    bool clipReady;

    /// <summary>The first part of the saved file's name: chess-fighter-win-checkmate. The date and time are added in the browser.</summary>
    string ClipNameStem()
    {
        string outcome = S.Result switch
        {
            GameResult.Draw => "draw",
            GameResult.WhiteWins => S.VsAi ? "win" : "white-wins",
            GameResult.BlackWins => S.VsAi ? "loss" : "black-wins",
            _ => "game",
        };
        string why = new string((S.ResultReason ?? "").ToLowerInvariant().Where(char.IsLetter).ToArray());
        return "chess-fighter-" + outcome + (why.Length > 0 ? "-" + why : "");
    }

    /// <summary>Records the clip (this takes as long as the clip, in real time). Sharing is a separate tap: phones only open the share sheet straight after a tap.</summary>
    async Task RenderClip()
    {
        clipBusy = true;
        clipReady = false;
        clipMsg = "Rendering your clip in real time...";
        StateHasChanged();
        try { await JS.InvokeVoidAsync("pcclip.stop"); } catch { }
        try
        {
            var res = await JS.InvokeAsync<ClipResult>("pcclip.record", BuildClipJson(), ClipNameStem());
            if (!res.Ok) clipMsg = res.Error ?? "Recording failed.";
            else { clipReady = true; clipMsg = "Your video is ready."; }
        }
        catch (Exception ex) { clipMsg = "Recording failed: " + ex.Message; }
        clipBusy = false;
    }

    async Task SendClip()
    {
        string how;
        try { how = await JS.InvokeAsync<string>("pcclip.share", ChessFighter.Web.Game.BuildInfo.Url); } catch { how = "error"; }
        clipMsg = how switch
        {
            "shared" => "Shared!",
            "cancelled" => "Share cancelled.",
            "unsupported" => "Your browser can't share videos. Use Save, then post it from your gallery.",
            _ => "Could not open the share sheet. Use Save, then post it from your gallery.",
        };
    }

    async Task SaveClip()
    {
        try { await JS.InvokeVoidAsync("pcclip.save"); clipMsg = "Saved to your downloads."; } catch { clipMsg = "Could not save the video."; }
    }

    async Task CloseClip()
    {
        try { await JS.InvokeVoidAsync("pcclip.stop"); } catch { }
        showClip = false;
    }

    public sealed class ClipResult
    {
        public bool Ok { get; set; }
        public string? Error { get; set; }
        public string? Mime { get; set; }
        public long Size { get; set; }
    }

    // ---------- ads (native shell only; the browser build has none) ----------

    readonly AdPolicy adPolicy = new();
    bool adsAvailable, adBusy;

    /// <summary>Starts a game, first showing an interstitial if the policy allows one. If the ad fails the game just starts.</summary>
    async Task StartNewAsync()
    {
        if (adsAvailable && !debugOptions && !adBusy && adPolicy.ShouldShowInterstitial(profile.Games, Environment.TickCount64, puzzle: false))
        {
            adBusy = true;
            StateHasChanged();
            try
            {
                adPolicy.RecordShown(profile.Games, Environment.TickCount64);
                await Ads.ShowInterstitialAsync();
            }
            catch { }
            adBusy = false;
        }
        StartNew();
    }

    async Task BuyHint()
    {
        if (adBusy) return;
        adBusy = true;
        StateHasChanged();
        bool earned = false;
        try { earned = await Ads.ShowRewardedAsync(); } catch { }
        adBusy = false;
        if (earned) S.AddHintBonus();
    }

    async Task DoubleXp()
    {
        if (adBusy || reward == null) return;
        adBusy = true;
        StateHasChanged();
        bool earned = false;
        try { earned = await Ads.ShowRewardedAsync(); } catch { }
        adBusy = false;
        int xpBeforeAd = profile.Xp;
        if (earned && RewardedXp.Double(profile, reward))
        {
            _ = RunXpAnim(xpBeforeAd, profile.Xp);
            RefreshUnlocks();
            opt.Level = debugOptions && opt.Level >= 0 ? opt.Level : profile.Level;
            _ = SetItemAsync(ProfileKey, ProfileCodec.Encode(profile));
        }
    }

    void StartNew() => StartNew(persist: true);

    void StartNew(bool persist)
    {
        if (S != null) { S.Changed = null; S.Sfx = null; S.Persist = null; }
        if (!urlSeed) opt.Seed = (ulong)DateTime.UtcNow.Ticks;
        if (opt.Watch) opt.Level = -1;   // watching: everything is in the pool
        else if (!debugOptions) opt.Level = profile.Level;
        pendingResume = false;
        S = new GameSession(opt, tut);
        WireSession();
        reward = null;
        xpAnimDone = true;
        _ = AiOpening(S);
        if (persist && !debugOptions) EnablePersist();
    }

    /// <summary>When the player is Black the rival opens: wait for the ROUND banner, then let it move.</summary>
    async Task AiOpening(GameSession sess)
    {
        if (sess.Spectate) { await Task.Delay(1500); if (sess == S && sess.Moves == 0 && !sess.GameOver) await sess.ResumeAi(); return; }
        if (sess.HumanSide != Side.Black || !sess.VsAi || sess.Puzzle != null) return;
        await Task.Delay(1500);
        if (sess == S && sess.Moves == 0 && !sess.GameOver) await sess.ResumeAi();
    }

    void EnablePersist()
    {
        S.Persist = text => { _ = PersistAsync(text); };
        S.Persist(S.GameOver ? null : S.SaveString());
    }

    async Task SetItemAsync(string key, string value)
    {
        try { await JS.InvokeVoidAsync("localStorage.setItem", key, value); } catch { }
    }

    async Task PersistAsync(string? text)
    {
        try
        {
            if (text == null) await JS.InvokeVoidAsync("localStorage.removeItem", SaveKey);
            else await JS.InvokeVoidAsync("localStorage.setItem", SaveKey, text);
        }
        catch { /* private mode or quota: resuming just will not work */ }
    }

    async Task PlaySfx(string name)
    {
        try { await JS.InvokeVoidAsync("pcfx.play", name); } catch { }
    }

    async Task ToggleMute()
    {
