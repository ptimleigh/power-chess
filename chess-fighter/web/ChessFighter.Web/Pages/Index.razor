    static readonly CardKind[] CardKinds = Enumerable.Range(Cards.First, Cards.Last - Cards.First + 1).Select(i => (CardKind)i).ToArray();

    /// <summary>One side's card bag, visible to both players. The side to move can tap an at-will card to play it.</summary>
    RenderFragment Bag(Side side) => @<text>
        @{ var held = CardKinds.Where(k => S.State.CardCount(side, k) > 0).ToList(); }
        @if (held.Count > 0)
        {
            <section class="bag @(side == Side.Black ? "opp" : "me")" data-testid="bag-@side.ToString().ToLowerInvariant()">
                @foreach (var k in held)
                {
                    var kind = k;
                    bool mine = S.HumanTurn && S.Turn == side && (!S.VsAi || side == Side.White) && !CardInfo.IsReaction(kind);
                    <button class="card-item @(CardInfo.IsReaction(kind) ? "react" : "will") @(S.SelectedCard == kind ? "on" : "")" disabled="@(!mine)"
                            data-card="@kind.ToString().ToLowerInvariant()" title="@Names.CardDesc(kind)" @onclick="() => S.SelectCard(kind)">
                        <span class="ci">@Icons.Svg(Names.CardIcon(kind))</span>
                        <span class="cl">@Names.CardShort(kind)</span>
                        <span class="cc">@S.State.CardCount(side, kind)</span>
                    </button>
                }
            </section>
        }
    </text>;

    /// <summary>Fighting-game "health": the share of the starting material (39 points) a side still has.</summary>
    int Hp(Side side)
    {
        // K.O.: the side that lost the game has an empty bar, whatever material it still had.
        if (S.GameOver && S.Winner() is Side winner && winner != side) return 0;
        int total = 0;
        foreach (var p in S.ViewPieces)
        {
            if (p.Side != side || p.Dying) continue;
            total += p.Type switch { PieceType.Pawn => 1, PieceType.Knight => 3, PieceType.Bishop => 3, PieceType.Rook => 5, PieceType.Queen => 9, _ => 0 };
        }
        return Math.Clamp(total * 100 / 39, 0, 100);
    }

    RenderFragment InvChips(Side side) => @<text>
        @foreach (var k in ChipKinds)
        {
            int n = S.Perk(side, k.Kind);
            <span class="chip @(n == 0 ? "zero" : "")" title="@k.Tip" data-chip="@k.Kind.ToString().ToLowerInvariant()">@Icons.Svg(Names.Icon(k.Kind))<b>@n</b></span>
        }
    </text>;

