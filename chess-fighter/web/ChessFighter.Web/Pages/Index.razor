    // ---------- presentation helpers ----------

    string TileClass(int sq)
    {
        bool light = (Sq.File(sq) + Sq.Rank(sq)) % 2 == 1;
        var c = "sq " + (light ? "light" : "dark");
        var cell = S.View.Cells[sq];
        if (S.View.Mystery[sq]) c += " mystery powerup " + Names.SquareClass((PowerupKind)S.View.Content[sq]);
        else if (S.View.Portal[sq]) c += " portal powerup pu-portal";
        if (S.View.Boulders[sq]) c += " rock";
        if (sq == S.ViewLastFrom || sq == S.ViewLastTo) c += " last";
        if (sq == S.Selected) c += " selected";
        if (sq == S.HintFrom || sq == S.HintTo) c += " hint";
        if (S.EffectPending && S.HumanTurn && S.EffectTargets.Contains(sq)) c += " aim";
        if (cardAim.Contains(sq))
        {
            if (S.ActiveCard == CardKind.MissileStrike)
            {
                // Four big blocks instead of 64 lit squares: only the outer edge of each quadrant is drawn.
                int f = Sq.File(sq) % 4, r = Sq.Rank(sq) % 4;
                c += " quad";
                if (f == 0) c += " ql";
                if (f == 3) c += " qr";
                if (r == 0) c += " qb";
                if (r == 3) c += " qt";
            }
            else c += " aim";
        }
        if (missileZone.Contains(sq)) c += " missile";
        if (S.Targets.Contains(sq))
        {
            bool enemy = !cell.IsEmpty && cell.Side != S.Turn;
            c += S.Mode == InputMode.Armed || S.Mode == InputMode.FireAim || S.Mode == InputMode.HarpoonAim
                ? " aim"
                : enemy ? " target cap" : " target";
        }
        if (S.Doomed.Contains(sq)) c += " doomed";
        if (S.Spared.Contains(sq)) c += " spared";
        if (S.BlastArea.Contains(sq)) c += " blast";
        if (S.InCheck && !S.Reviewing && cell.Type == PieceType.King && cell.Side == S.Turn && !S.GameOver) c += " check";
        return c;
    }

