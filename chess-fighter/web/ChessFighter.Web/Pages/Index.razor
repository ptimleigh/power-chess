    /// <summary>A prefilled bug report: which build, how far along, how the last game ended, and what device.</summary>
    internal string FeedbackText(string userAgent)
    {
        string last = S.GameOver ? $"{S.Result} ({S.ResultReason})" : $"in progress, move {S.Moves}";
