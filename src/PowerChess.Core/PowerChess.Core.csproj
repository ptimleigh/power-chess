<Project Sdk="Microsoft.NET.Sdk">

  <!-- Builds the engine in Assets/Core outside Unity so it can be unit-tested and reused on a server. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>PowerChess.Core</RootNamespace>
    <AssemblyName>PowerChess.Core</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Assets/Core/**/*.cs" />
  </ItemGroup>

</Project>
