}

@if (showProfile)
{
    <div class="modal" data-testid="profile" @onclick="() => showProfile = false">
        <div class="card help" @onclick:stopPropagation="true">
            <div class="kicker">Your profile</div>
            <div class="xp-line"><b>Level @profile.Level</b><small>@profile.Xp XP</small></div>
            <div class="xpbar"><i style="width:@(XpPercent(profile))%"></i></div>
            <div class="lv-line">@NextUnlockText</div>
            <div class="lv-line">Daily streak: @Daily.ActiveStreak(profile, today) (best @profile.BestStreak, @profile.DailySolved solved)</div>
            <ul class="stats">
                <li><b>@profile.Games</b><small>Games</small></li>
                <li><b>@profile.Wins</b><small>Wins</small></li>
                <li><b>@profile.Losses</b><small>Losses</small></li>
                <li><b>@profile.Draws</b><small>Draws</small></li>
                <li><b>@profile.Mates</b><small>Mates</small></li>
                <li><b>@profile.Captures</b><small>Captures</small></li>
                <li><b>@profile.Collected</b><small>Powerups</small></li>
                <li><b>@profile.FireballKills</b><small>Burned</small></li>
            </ul>
            <div class="opt-label">Trophies @(Trophies.All.Count(t => profile.Has(t))) / @Trophies.All.Length</div>
            <div class="trophies">
                @foreach (var t in Trophies.All)
                {
                    bool got = profile.Has(t);
                    <div class="trophy @(got ? "got" : "locked")" data-trophy="@t.Name" data-got="@(got ? "1" : "0")">
                        <span class="ti">@Icons.Svg(got ? "star" : "lock")</span>
                        <b>@t.Name</b>
