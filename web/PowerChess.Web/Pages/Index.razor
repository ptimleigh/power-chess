                        <button class="chip-btn on" data-level="@v" @onclick="() => selCustom = Presets.SetCustom(selCustom, idx, (Presets.CustomLevelOf(selCustom, idx) + 1) % 4)">@(new[] { "Off", "Low", "Normal", "High" }[v])</button>
                    </div>
