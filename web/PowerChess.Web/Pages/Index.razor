@page "/"
@implements IDisposable
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Power Chess</PageTitle>

<div class="app">
    <header class="topbar">
        <div class="logo" data-action="logo" @onclick="LogoTap">POWER<span>CHESS</span></div>
        <div class="controls">
            <button class="icon-btn @(muted ? "muted" : "")" @onclick="ToggleMute" title="Sound" aria-label="Toggle sound">SFX</button>
            <button class="icon-btn daily" data-action="daily" title="Daily challenge" @onclick="OpenDaily"><span>Daily</span>@if (!Daily.SolvedToday(profile, today)) { <i class="dot"></i> }</button>
            <button class="icon-btn lvl" data-action="profile" title="Profile" @onclick="() => showProfile = true">Lv <b>@profile.Level</b></button>
            <button class="icon-btn" @onclick="() => showHelp = true" title="How to play" aria-label="How to play">?</button>
            <button class="icon-btn wide" data-action="new" @onclick="OpenNew">New</button>
        </div>
    </header>

    <section class="player opp @(S.Turn == Side.Black && !S.GameOver ? "active" : "")">
        <div class="avatar b"></div>
        <div class="pname">@(S.VsAi ? "Rival" : "Black")</div>
        <div class="chips">@InvChips(Side.Black)</div>
    </section>

    @if (S.Puzzle is PuzzleDef pz)
    {
        <section class="puzzle-hud" data-testid="puzzle-hud">
            <div class="ph-main">
                <b>@pz.Title</b>
                <span class="ph-goal">Checkmate in @pz.MaxMoves @(pz.MaxMoves == 1 ? "move" : "moves") · <span data-testid="puzzle-count">@S.PuzzleMoves/@pz.MaxMoves</span> used</span>
                <small>@pz.Hint</small>
            </div>
            <div class="ph-btns">
                <button class="btn small" data-action="puzzle-retry" @onclick="RetryPuzzle">Retry</button>
                <button class="btn small ghost" data-action="puzzle-quit" @onclick="QuitPuzzle">Quit</button>
            </div>
        </section>
    }

    <div class="board-frame">
        <div class="board @(S.Shaking ? "shaking sk" + S.ShakeLevel : "") @(S.Frozen ? "freeze" : "") @(S.Punch ? "punch" : "")" data-testid="board">
            @for (int rank = 7; rank >= 0; rank--)
            {
                for (int file = 0; file < 8; file++)
                {
                    int sq = Sq.Make(file, rank);
                    <div class="@TileClass(sq)" data-sq="@Sq.Name(sq)" data-content="@ContentName(sq)" @onclick="() => S.TapSquare(sq)">
                        @if (S.View.Mystery[sq])
                        {
                            <PowerupMark Kind="(PowerupKind)S.View.Content[sq]" />
                        }
                        else if (S.View.Portal[sq])
                        {
                            <span class="pu-edge"></span>
                            <span class="pu-glyph">@Icons.Svg("portal")</span>
                        }
                        @if (S.View.Boulders[sq])
                        {
                            <span class="boulder">@Icons.Svg("rock")</span>
                        }
                        @if (file == 0)
                        {
                            <i class="coord rank">@(rank + 1)</i>
                        }
                        @if (rank == 0)
                        {
                            <i class="coord file">@((char)('a' + file))</i>
                        }
                    </div>
                }
            }

            <div class="layer pieces">
                @foreach (var p in S.ViewPieces)
                {
                    <PieceItem @key="p.Id" P="p" Lifted="@(p.Square == S.Selected)" />
                }
            </div>

            <div class="layer fx">
                <FxLayer Items="S.Effects" />
            </div>

            <div class="toasts">
                @foreach (var t in S.Toasts)
                {
                    <div @key="t.Id" class="toast @t.Css">
                        <span class="ticon">@Icons.Svg(t.Icon)</span>
                        <span class="ttext"><b>@t.Title</b>@if (t.Text != "") { <small>@t.Text</small> }</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <section class="player me @(S.Turn == Side.White && !S.GameOver ? "active" : "")">
        <div class="avatar w"></div>
        <div class="pname">@(S.VsAi ? "You" : "White")@if (RulesLabel.Length > 0) { <span class="rules-badge" data-testid="rules-badge">@RulesLabel</span> }</div>
        <div class="chips">@InvChips(Side.White)</div>
    </section>

    <section class="actions">
        @if (S.Reviewing)
        {
            <div class="review" data-testid="review">
                <div class="review-label" data-testid="review-label">
                    <span class="rp">Move @S.ReviewPosition of @S.HistoryCount</span>
                    <span>@S.ReviewLabel</span>
                </div>
                <div class="review-btns">
                    <button class="rbtn" data-review="first" disabled="@(S.ReviewPosition <= 0)" aria-label="First" @onclick="() => S.ReviewTo(0)">@Icons.Svg("first")</button>
                    <button class="rbtn" data-review="prev" disabled="@(S.ReviewPosition <= 0)" aria-label="Previous move" @onclick="() => S.ReviewStep(-1)">@Icons.Svg("prev")</button>
                    <button class="rbtn" data-review="next" aria-label="Next move" @onclick="() => S.ReviewStep(1)">@Icons.Svg("next")</button>
                    <button class="rbtn" data-review="last" aria-label="Latest" @onclick="S.ExitReview">@Icons.Svg("last")</button>
                    <button class="btn primary review-exit" data-action="exit-review" @onclick="S.ExitReview">Back to game</button>
                </div>
            </div>
        }
        else
        {
        @foreach (var perk in PerkButtons)
        {
            var k = perk;
            if (k.Action == ActionKind.ClearBoulder && S.State.BoulderCount() == 0) { continue; }
            if (k.Kind == PowerupKind.Swap && S.Perk(ActiveSide, PowerupKind.Swap) == 0) { continue; }
            <button class="perk @(S.Mode == InputMode.Armed && S.ArmedKind == k.Action ? "on" : "")" disabled="@(!S.CanUse(k.Action))"
                    data-perk="@k.Kind.ToString().ToLowerInvariant()" @onclick="() => S.Arm(k.Action)">
                <span class="pi">@Icons.Svg(Names.Icon(k.Kind))</span>
                <span class="pl">@k.Label</span>
                <span class="pc">@S.Perk(ActiveSide, k.Kind)</span>
            </button>
        }
        @if (S.Perk(ActiveSide, PowerupKind.Rewind) > 0)
        {
            <button class="perk" disabled="@(!S.CanRewind)" data-perk="rewind" @onclick="S.RewindClick">
                <span class="pi">@Icons.Svg("rewind")</span>
                <span class="pl">Rewind</span>
                <span class="pc">@S.Perk(ActiveSide, PowerupKind.Rewind)</span>
            </button>
        }
        @if (S.HasFireball)
        {
            <button class="perk fire-btn" data-action="fire" @onclick="S.StartFire">
                <span class="pi">@Icons.Svg("fire")</span><span class="pl">Fireball</span>
            </button>
        }
        @if (S.HasDetonate)
        {
            <button class="perk boom-btn" data-action="detonate" @onclick="S.PreviewBomb">
                <span class="pi">@Icons.Svg("bomb")</span><span class="pl">Detonate</span>
            </button>
        }
        @if (S.Mode == InputMode.BombPreview)
        {
            <button class="perk boom-btn" data-action="bomb-confirm" @onclick="S.Detonate">
                <span class="pi">@Icons.Svg("bomb")</span><span class="pl">Confirm blast</span>
            </button>
        }
        @if (S.Mode != InputMode.Normal && S.Mode != InputMode.Promotion)
        {
            <button class="perk ghost" @onclick="S.Cancel"><span class="pl">Cancel</span></button>
        }
        @if (S.CanReview)
        {
            <button class="perk ghost" data-action="review" @onclick="() => S.ReviewStep(-1)">
                <span class="pi">@Icons.Svg("history")</span><span class="pl">Moves</span>
            </button>
        }
        }
    </section>

    @if (showDebug)
    {
        <section class="debug" data-testid="debug">
            <div class="debug-head"><b>DEBUG</b><small>@(S.DebugHint == "" ? "Pick a tool, then tap the board" : S.DebugHint)</small>
                <button class="x" aria-label="Close debug" @onclick="CloseDebug">x</button></div>
            <div class="debug-row"><span>Perk +1</span>
                @foreach (var k in DebugPerks)
                {
                    var kk = k;
                    <button class="dbtn" data-dperk="@kk.ToString().ToLowerInvariant()" @onclick="() => S.DebugGivePerk(kk)">@Names.Name(kk)</button>
                }
            </div>
            <div class="debug-row"><span>Buff a piece</span>
                @foreach (var k in DebugBuffs)
                {
                    var kk = k;
                    <button class="dbtn @(S.DebugArmed == DebugTool.Buff && S.DebugKind == kk ? "on" : "")" data-dbuff="@kk.ToString().ToLowerInvariant()" @onclick="() => S.DebugArm(DebugTool.Buff, kk)">@Names.Name(kk)</button>
                }
            </div>
            <div class="debug-row"><span>Drop square</span>
                <button class="dbtn @(S.DebugArmed == DebugTool.Square && S.DebugKind == PowerupKind.None ? "on" : "")" data-dsquare="hidden" @onclick="() => S.DebugArm(DebugTool.Square, PowerupKind.None)">? Mystery</button>
                @foreach (var k in DebugSquares)
                {
                    var kk = k;
                    <button class="dbtn @(S.DebugArmed == DebugTool.Square && S.DebugKind == kk ? "on" : "")" data-dsquare="@kk.ToString().ToLowerInvariant()" @onclick="() => S.DebugArm(DebugTool.Square, kk)">@Names.Name(kk)</button>
                }
                <button class="dbtn @(S.DebugArmed == DebugTool.Portal ? "on" : "")" data-dsquare="portal" @onclick="() => S.DebugArm(DebugTool.Portal)">Teleporters</button>
                <button class="dbtn warn @(S.DebugArmed == DebugTool.Clear ? "on" : "")" data-dsquare="clear" @onclick="() => S.DebugArm(DebugTool.Clear)">Remove</button>
            </div>
            <div class="debug-row"><span>Progress</span>
                <button class="dbtn" data-dprog="max" @onclick="() => DebugXp(Progression.XpForLevel(Progression.MaxLevel))">Max level</button>
                <button class="dbtn" data-dprog="plus" @onclick="() => DebugXp(profile.Xp + 100)">+100 XP</button>
                <button class="dbtn" data-dprog="nextday" @onclick="() => today++">Next day</button>
                <button class="dbtn warn" data-dprog="reset" @onclick="() => DebugXp(0, true)">Reset profile</button>
            </div>
        </section>
    }

    <div class="status @(S.InCheck && !S.GameOver ? "warn" : "")" data-testid="status">@S.Status</div>

    @if (S.Inspect >= 0 && !S.Reviewing && S.Tutorial == null && !S.State.Cells[S.Inspect].IsEmpty)
    {
        var ip = S.State.Cells[S.Inspect];
        <div class="inspect" data-testid="inspect">
            <div class="inspect-head">
                <b>@InspectTitle(ip)</b>
                <button class="x" aria-label="Close" @onclick="S.CloseInspect">x</button>
            </div>
            @foreach (var flag in new[] { Buff.DoubleMove, Buff.TripleMove, Buff.Ghost, Buff.Poison, Buff.Armor, Buff.Fireball, Buff.SmallBomb, Buff.BigBomb })
            {
                if (!ip.Has(flag)) { continue; }
                var kind = Names.ForBuff(flag);
                <div class="inspect-row">
                    <span class="gi buff">@Icons.Svg(Names.Icon(kind))</span>
                    <span>
                        <b>@Names.Name(kind)</b>
                        @(flag == Buff.Armor
                            ? $"Immune to capture and effects for {ip.ArmorTurns} more opponent {(ip.ArmorTurns == 1 ? "turn" : "turns")}."
                            : flag == Buff.Ghost
                            ? $"Slides through pieces and boulders for {ip.GhostTurns} more of its owner's {(ip.GhostTurns == 1 ? "turn" : "turns")}."
                            : Names.Desc(kind))
                    </span>
                    <button class="demo-btn" data-demo="@kind.ToString().ToLowerInvariant()" @onclick="() => S.ShowTutorial(kind)">Demo</button>
                </div>
            }
            @if (ip.IsStunned)
            {
                <div class="inspect-row">
                    <span class="gi perk">@Icons.Svg("star")</span>
                    <span>
                        <b>Frozen</b>
                        @($"Can't move for {ip.StunTurns} more of its owner's {(ip.StunTurns == 1 ? "turn" : "turns")}, and can't give check.")
                    </span>
                    <button class="demo-btn" data-demo="stun" @onclick="() => S.ShowTutorial(PowerupKind.Stun)">Demo</button>
                </div>
            }
        </div>
    }
</div>

@if (S.InspectSquare >= 0 && !S.Reviewing && S.Tutorial == null && S.State.Portal[S.InspectSquare] && !S.State.Mystery[S.InspectSquare])
{
    <div class="inspect sqinfo" data-testid="inspect-square" data-content="portal">
        <div class="inspect-head">
            <b>Teleporter</b>
            <button class="x" aria-label="Close" @onclick="S.CloseInspect">x</button>
        </div>
        <div class="inspect-row">
            <span class="gi perk">@Icons.Svg("portal")</span>
            <span>@Names.PortalDesc</span>
        </div>
    </div>
}
else if (S.InspectSquare >= 0 && !S.Reviewing && S.Tutorial == null && S.State.Mystery[S.InspectSquare])
{
    var sk = (PowerupKind)S.State.Content[S.InspectSquare];
    <div class="inspect sqinfo" data-testid="inspect-square" data-content="@ContentName(S.InspectSquare)">
        <div class="inspect-head">
            <b>@(sk == PowerupKind.None ? "Mystery square" : Names.Name(sk))</b>
            <button class="x" aria-label="Close" @onclick="S.CloseInspect">x</button>
        </div>
        <div class="inspect-row">
            <span class="gi @(sk != PowerupKind.None && PowerupInfo.IsPerk(sk) ? "perk" : "buff")">@(sk == PowerupKind.None ? Icons.Svg("question") : Icons.Svg(Names.Icon(sk)))</span>
            <span>@(sk == PowerupKind.None ? "Land a piece here to find out what it holds. Squares appear in matching pairs." : Names.Desc(sk))</span>
            @if (sk != PowerupKind.None)
            {
                <button class="demo-btn" data-demo="@sk.ToString().ToLowerInvariant()" @onclick="() => S.ShowTutorial(sk)">Demo</button>
            }
        </div>
    </div>
}

@if (S.Tutorial is PowerupKind tk)
{
    <div class="tutorial" data-testid="tutorial" data-kind="@tk.ToString().ToLowerInvariant()">
        <DemoBoard Kind="tk" />
        <div class="tut-text">
            <div class="tut-title">
                <span class="gi @(PowerupInfo.IsPerk(tk) ? "perk" : "buff")">@Icons.Svg(Names.Icon(tk))</span>
                <b>@TutorialTitle(tk)</b>
            </div>
            <p>@TutorialText(tk)</p>
            <label class="chk"><input type="checkbox" data-testid="tut-off" @bind="S.DontShowAgain" /> Don't show tutorials again</label>
            <button class="btn primary tut-ok" data-action="tutorial-ok" @onclick="S.DismissTutorial">Got it</button>
        </div>
    </div>
}

@if (S.PickupPending && S.HumanTurn)
{
    var kind = S.State.PendingKind;
    <div class="modal" data-testid="pickup">
        <div class="card pop">
            <div class="kicker">Mystery square!</div>
            <div class="big-icon @(PowerupInfo.IsPerk(kind) ? "perk" : "buff")">@Icons.Svg(Names.Icon(kind))</div>
            <h2>@Names.Name(kind)</h2>
            <p>@Names.Desc(kind)</p>
            @if (S.PickupTutorial)
            {
                <DemoBoard Kind="kind" />
                <label class="chk"><input type="checkbox" data-testid="tut-off" @bind="S.DontShowAgain" /> Don't show tutorials again</label>
            }
            <div class="row">
                <button class="btn primary" data-action="keep" @onclick="S.KeepPickup">Keep it</button>
                @if (S.Perk(S.Turn, PowerupKind.Reroll) > 0)
                {
                    <button class="btn" data-action="reroll" @onclick="S.RerollPickup">Reroll (@S.Perk(S.Turn, PowerupKind.Reroll))</button>
                }
            </div>
        </div>
    </div>
}

@if (S.Mode == InputMode.Promotion)
{
    <div class="modal" data-testid="promotion">
        <div class="card pop">
            <div class="kicker">Promote your pawn</div>
            <div class="row promo">
                @foreach (var a in S.PromoChoices)
                {
                    var choice = a;
                    <button class="btn promo-btn" data-promo="@((PieceType)choice.Aux)" @onclick="() => S.Choose(choice)">
                        <PieceSvg Type="(PieceType)choice.Aux" Side="S.Turn" />
                    </button>
                }
            </div>
            <button class="btn ghost" @onclick="S.Cancel">Cancel</button>
        </div>
    </div>
}

@if (S.GameOver && !S.Busy && !S.Reviewing && S.Puzzle == null)
{
    <div class="modal" data-testid="gameover">
        <div class="card pop result @ResultClass">
            <div class="kicker">@S.Status</div>
            <h1>@ResultTitle</h1>
            <p>@ResultText</p>
            @if (reward is MatchReward rw)
            {
                <div class="reward" data-testid="reward">
                    <div class="xp-line"><b>+@rw.XpGained XP</b>
                        <small>@string.Join(" · ", rw.Breakdown.Select(b => $"{b.Key} {b.Value}"))</small></div>
                    <div class="xpbar"><i style="width:@(XpPercent(profile))%"></i></div>
                    <div class="lv-line">Level @profile.Level@(profile.Level < Progression.MaxLevel ? $" · {Progression.XpForLevel(profile.Level + 1) - profile.Xp} XP to level {profile.Level + 1}" : " · max")</div>
                    @if (rw.NewLevel > rw.OldLevel)
                    {
                        <div class="levelup" data-testid="levelup">LEVEL UP! You reached level @rw.NewLevel</div>
                        @if (rw.NewPowerups.Count > 0 || rw.NewTeleporters)
                        {
                            <div class="unlocks">Unlocked: @string.Join(", ", rw.NewPowerups.Select(Names.Name).Concat(rw.NewTeleporters ? new[] { "Teleporters" } : Array.Empty<string>()))</div>
                        }
                    }
                    @foreach (var t in rw.NewTrophies)
                    {
                        <div class="trophy-new" data-trophy-new="@t.Name"><span>@Icons.Svg("star")</span><b>@t.Name</b><small>@t.Description</small></div>
                    }
                </div>
            }
            <button class="btn primary" data-action="again" @onclick="StartNew">Play again</button>
            @if (S.CanReview)
            {
                <button class="btn ghost" data-action="review-game" @onclick="() => S.ReviewStep(-1)">Review the game</button>
            }
        </div>
    </div>
}

@if (S.Puzzle is PuzzleDef rz && S.PuzzleOutcome != PuzzleResult.None && !S.Busy)
{
    <div class="modal" data-testid="puzzle-result">
        <div class="card pop result @(S.PuzzleOutcome == PuzzleResult.Solved ? "win" : "lose")">
            <div class="kicker">@rz.Title</div>
            <h1>@(S.PuzzleOutcome == PuzzleResult.Solved ? "SOLVED!" : "NOT QUITE")</h1>
            @if (S.PuzzleOutcome == PuzzleResult.Solved)
            {
                <p>Checkmate in @S.PuzzleMoves of @rz.MaxMoves @(rz.MaxMoves == 1 ? "move" : "moves").</p>
                @if (puzzleReward is MatchReward pr)
                {
                    <div class="reward" data-testid="puzzle-reward">
                        <div class="xp-line"><b>+@pr.XpGained XP</b>
                            <small>@string.Join(" · ", pr.Breakdown.Select(b => $"{b.Key} {b.Value}"))</small></div>
                        <div class="streak-line" data-testid="streak">Daily streak: <b>@profile.DailyStreak</b> @(profile.DailyStreak == 1 ? "day" : "days")</div>
                        @if (pr.NewLevel > pr.OldLevel) { <div class="levelup">LEVEL UP! You reached level @pr.NewLevel</div> }
                        @foreach (var t in pr.NewTrophies)
                        {
                            <div class="trophy-new" data-trophy-new="@t.Name"><span>@Icons.Svg("star")</span><b>@t.Name</b><small>@t.Description</small></div>
                        }
                    </div>
                }
                else
                {
                    <p class="fine">Already counted today. Come back tomorrow for a new puzzle.</p>
                }
                <button class="btn" data-action="share" @onclick="SharePuzzle">@(shared ? "Copied!" : "Copy result")</button>
            }
            else
            {
                <p>@(S.Result == GameResult.Ongoing ? "You ran out of moves." : "The game ended without your checkmate.") Give it another go.</p>
                <button class="btn primary" data-action="puzzle-retry-result" @onclick="RetryPuzzle">Retry</button>
            }
            <button class="btn ghost" data-action="puzzle-quit-result" @onclick="QuitPuzzle">Back to game</button>
        </div>
    </div>
}

@if (showDaily)
{
    var dp = Daily.PuzzleFor(today);
    bool done = Daily.SolvedToday(profile, today);
    <div class="modal" data-testid="daily" @onclick="() => showDaily = false">
        <div class="card help" @onclick:stopPropagation="true">
            <div class="kicker">Daily challenge · @DateTime.UnixEpoch.AddDays(today).ToString("MMM d")</div>
            <div class="streak-big" data-testid="daily-streak"><span class="flame">@Icons.Svg("fire")</span><b>@Daily.ActiveStreak(profile, today)</b><small>day streak · best @profile.BestStreak</small></div>
            <h2 class="daily-title">@dp.Title</h2>
            <p>Checkmate in <b>@dp.MaxMoves</b> @(dp.MaxMoves == 1 ? "move" : "moves"). Difficulty: @(dp.Tier == 1 ? "easy" : dp.Tier == 2 ? "medium" : "hard").</p>
            <p class="fine">@dp.Hint</p>
            @if (done)
            {
                <p class="solved-today" data-testid="daily-done">Solved today. A new puzzle arrives tomorrow.</p>
                <button class="btn" data-action="daily-play" @onclick="StartPuzzle">Play again for fun</button>
            }
            else
            {
                <p class="fine">Solve it for @Daily.XpForStreak(Daily.ActiveStreak(profile, today) + 1) XP (more with a longer streak).</p>
                <button class="btn primary" data-action="daily-play" @onclick="StartPuzzle">Play</button>
            }
            <button class="btn ghost" @onclick="() => showDaily = false">Close</button>
        </div>
    </div>
}

@if (showNew)
{
    <div class="modal" data-testid="newgame" @onclick="() => showNew = false">
        <div class="card newgame" @onclick:stopPropagation="true">
            <div class="kicker">New game</div>
            <div class="opt-label">Powerup squares</div>
            <div class="seg">
                <button class="@Seg(selMode == SquareMode.Revealed)" data-mode="revealed" @onclick="() => selMode = SquareMode.Revealed">
                    <b>Revealed</b><small>See what each square holds. A few stay a mystery.</small>
                </button>
                <button class="@Seg(selMode == SquareMode.Mystery)" data-mode="mystery" @onclick="() => selMode = SquareMode.Mystery">
                    <b>Mystery</b><small>Every square is a "?" until you land on it.</small>
                </button>
            </div>
            <div class="opt-label">Opponent</div>
            <div class="seg six">
                @foreach (var lv in new[] { 1, 2, 3, 4, 5, 0 })
                {
                    int level = lv;
                    <button class="@Seg(selAi == level)" data-ai="@level" @onclick="() => selAi = level">@Ai.LevelName(level)</button>
                }
            </div>
            <div class="opt-label">Rules</div>
            <div class="chips" data-testid="preset-chips">
                @foreach (var pr in PresetChoices())
                {
                    var choice = pr;
                    bool open = Presets.Available(choice.id, EffectiveLevel);
                    <button class="@Seg(selPreset == choice.id && open) chip-btn @(open ? "" : "locked")" data-preset="@choice.id" disabled="@(!open)" title="@choice.blurb" @onclick="() => selPreset = choice.id">
                        <b>@choice.name</b>
                        @if (!open) { <small>Level @choice.level</small> }
                    </button>
                }
            </div>
            @if (selPreset != Presets.Classic && Presets.Available(selPreset, EffectiveLevel))
            {
                <div class="preset-blurb" data-testid="preset-blurb">@PresetBlurb(selPreset) <em>Half XP.</em></div>
            }
            @if (selPreset == Presets.Custom && Presets.Available(selPreset, EffectiveLevel))
            {
                <button class="btn ghost small" data-action="customize" @onclick="() => showCustom = true">Customize powerups</button>
            }
            <div class="opt-label">Square frequency</div>
            <div class="chips" data-testid="freq-chips">
                @foreach (var fq in new[] { Frequency.Rare, Frequency.Normal, Frequency.Frequent, Frequency.Chaos })
                {
                    var f = fq;
                    bool open = Presets.FrequencyAvailable(EffectiveLevel);
                    <button class="@Seg(selFreq == f && (open || f == Frequency.Normal)) chip-btn @(open || f == Frequency.Normal ? "" : "locked")" data-freq="@((int)f)" disabled="@(!open && f != Frequency.Normal)" @onclick="() => selFreq = f">
                        <b>@Presets.FrequencyName(f)</b>
                        @if (!open && f != Frequency.Normal) { <small>Level @Presets.FrequencyLevel</small> }
                    </button>
                }
            </div>
            <div class="opt-label">Effects</div>
            <div class="seg">
                <button class="@Seg(selDrama)" data-drama="on" @onclick="() => selDrama = true">
                    <b>Dramatic</b><small>Slashes, hit-stop and big callouts on captures.</small>
                </button>
                <button class="@Seg(!selDrama)" data-drama="off" @onclick="() => selDrama = false">
                    <b>Calm</b><small>Quick and quiet. Faster to play.</small>
                </button>
            </div>
            <div class="row newgame-row">
                <button class="btn primary" data-action="start-game" @onclick="StartFromSheet">Start game</button>
                <button class="btn ghost" data-action="cancel-new" @onclick="() => showNew = false">Cancel</button>
            </div>
        </div>
    </div>
}

@if (showCustom)
