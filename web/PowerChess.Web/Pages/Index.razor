@if (showHelp)
{
    <div class="modal" @onclick="() => showHelp = false">
        <div class="card help" @onclick:stopPropagation="true">
            <div class="kicker">How to play</div>
            <p>Normal chess with checkmate. Gold <b>?</b> squares appear in matching pairs. Land a piece on one to open it. Tap any powered-up piece to see what it has. The Moves button lets you look back at the game without changing it.</p>
            <ul class="guide">
                @foreach (var k in Names.Guide)
                {
                    <li class="@(Progression.Unlocked(k, EffectiveLevel) ? "" : "locked")" data-guide="@k.ToString().ToLowerInvariant()">
                        <span class="gi @(PowerupInfo.IsPerk(k) ? "perk" : "buff")">@Icons.Svg(Names.Icon(k))</span>
                        <span><b>@Names.Name(k)</b> @Names.Desc(k)@if (!Progression.Unlocked(k, EffectiveLevel)) { <em class="lockline"> Unlocks at level @Progression.UnlockLevel(k).</em> }</span>
                    </li>
                }
            </ul>
            <p class="fine">Kings are immune to every powerup. Perks, bombs and stun strikes use your turn.</p>
            <div class="row help-row">
                <button class="btn" data-action="training" @onclick="StartTraining">Learn the basics</button>
                <button class="btn" data-action="reset-tutorials" @onclick="ResetTutorials">Reset tutorials</button>
            </div>
            <button class="btn primary" @onclick="() => showHelp = false">Got it</button>
        </div>
    </div>
}

@code {
    GameOptions opt = new();
    bool urlSeed;
    bool muted;
    bool showHelp;
    bool showNew;
    bool showProfile;
    bool showDaily;
    bool shared;
    int today;
    MatchReward? puzzleReward;
    bool showDebug;
    Profile profile = new();
    MatchReward? reward;
    int EffectiveLevel => opt.Level < 0 ? Progression.MaxLevel : opt.Level;

    static int XpPercent(Profile p)
    {
        if (p.Level >= Progression.MaxLevel) return 100;
        int lo = Progression.XpForLevel(p.Level), hi = Progression.XpForLevel(p.Level + 1);
        return Math.Clamp((p.Xp - lo) * 100 / Math.Max(1, hi - lo), 0, 100);
    }

    string NextUnlockText
    {
        get
        {
            if (profile.Level >= Progression.MaxLevel) return "Max level. Everything is unlocked.";
            int next = profile.Level + 1;
            var names = Names.Guide.Concat(new[] { PowerupKind.TransformPawn })
                .Where(k => Progression.UnlockLevel(k) == next).Select(Names.Name).Distinct().ToList();
            if (next == Progression.TeleporterLevel) names.Add("Teleporters");
            return $"{Progression.XpForLevel(next) - profile.Xp} XP to level {next}" + (names.Count > 0 ? ": unlocks " + string.Join(", ", names) : "");
        }
    }

    async Task RefreshToday()
    {
        if (opt.Day is int forced) { if (today < forced) today = forced; return; }
        try { today = await JS.InvokeAsync<int>("pcfx.today"); }
        catch { today = Daily.DayNumber(DateTime.Now); }
    }

    async Task OpenDaily()
    {
        await RefreshToday();
        showDaily = true;
    }

    void WireSession()
    {
        S.Changed = () => InvokeAsync(StateHasChanged);
        S.TutorialsChanged = text => { _ = SetItemAsync(TutKey, text); };
        S.Sfx = name => { _ = PlaySfx(name); };
        S.GameEnded = OnGameEnded;
        S.PuzzleSolved = OnPuzzleSolved;
    }

    void StartPuzzle()
    {
        showDaily = false;
        shared = false;
        puzzleReward = null;
        var def = Daily.PuzzleFor(today);
        var popt = new GameOptions { Ai = 2, Puzzle = def, Seed = (ulong)DateTime.UtcNow.Ticks, Tutorials = opt.Tutorials, Drama = opt.Drama, Mode = opt.Mode, Level = -1 };
        if (S != null) { S.Changed = null; S.Sfx = null; S.Persist = null; }
        S = new GameSession(popt, tut);
        WireSession();
        reward = null;
    }

    void RetryPuzzle()
    {
        if (S.Puzzle != null) StartPuzzle();
    }

    async Task QuitPuzzle()
    {
        puzzleReward = null;
        StartNew(persist: false);
        string? saved = null;
        if (!debugOptions)
        {
            try { saved = await JS.InvokeAsync<string?>("localStorage.getItem", SaveKey); } catch { }
        }
        bool restored = !string.IsNullOrEmpty(saved) && S.Restore(saved);
        if (!debugOptions) EnablePersist();
        if (restored) await S.ResumeAi();
    }

    void OnPuzzleSolved(PuzzleDef def, int moves)
    {
        puzzleReward = Daily.AwardSolve(profile, today);
        _ = SetItemAsync(ProfileKey, ProfileCodec.Encode(profile));
        puzzleMoves = moves;
    }
    int puzzleMoves;

    async Task SharePuzzle()
    {
        var def = Daily.PuzzleFor(today);
        string text = $"Power Chess Daily {DateTime.UnixEpoch.AddDays(today):MMM d}: \"{def.Title}\" solved in {puzzleMoves}/{def.MaxMoves}. Streak {profile.DailyStreak}. https://ptimleigh.github.io/power-chess/";
        try { shared = await JS.InvokeAsync<bool>("pcfx.copy", text); } catch { shared = false; }
    }

    void OnGameEnded(MatchSummary m)
    {
        if ((debugOptions && !opt.Rewards) || !S.Rewardable) { reward = null; return; }
        reward = Progression.Award(profile, m);
        opt.Level = profile.Level;
        _ = SetItemAsync(ProfileKey, ProfileCodec.Encode(profile));
    }

    void DebugXp(int xp, bool reset = false)
    {
        if (reset) profile = new Profile(); else profile.Xp = xp;
        opt.Level = debugOptions && opt.Level >= 0 && !reset ? opt.Level : profile.Level;
        _ = SetItemAsync(ProfileKey, ProfileCodec.Encode(profile));
    }
    const string ProfileKey = "powerchess.profile.v1";
    int logoTaps;
    DateTime lastLogoTap;

    static readonly PowerupKind[] DebugPerks = { PowerupKind.Steal, PowerupKind.Stun, PowerupKind.Boulder, PowerupKind.Swap, PowerupKind.Reroll, PowerupKind.Rewind };
    static readonly PowerupKind[] DebugBuffs =
    {
        PowerupKind.DoubleMove, PowerupKind.TripleMove, PowerupKind.Ghost, PowerupKind.Poison, PowerupKind.SpikedArmor,
        PowerupKind.Fireball, PowerupKind.SmallBomb, PowerupKind.BigBomb,
        PowerupKind.TransformKnight, PowerupKind.TransformBishop, PowerupKind.TransformRook, PowerupKind.TransformQueen,
    };
    static readonly PowerupKind[] DebugSquares =
    {
        PowerupKind.DoubleMove, PowerupKind.TripleMove, PowerupKind.Ghost, PowerupKind.Poison, PowerupKind.SpikedArmor,
        PowerupKind.Fireball, PowerupKind.SmallBomb, PowerupKind.BigBomb, PowerupKind.TransformQueen,
        PowerupKind.Steal, PowerupKind.Stun, PowerupKind.Boulder, PowerupKind.Swap, PowerupKind.Reroll, PowerupKind.Rewind,
    };

    /// <summary>Tap the logo five times to open the debug tools (or start with ?debug=1).</summary>
    void LogoTap()
    {
        var now = DateTime.UtcNow;
        logoTaps = (now - lastLogoTap).TotalMilliseconds < 1500 ? logoTaps + 1 : 1;
        lastLogoTap = now;
        if (logoTaps >= 5) { logoTaps = 0; showDebug = !showDebug; if (!showDebug) S.DebugDisarm(); }
    }

    void CloseDebug()
    {
        showDebug = false;
        S.DebugDisarm();
    }
    SquareMode selMode = SquareMode.Revealed;
    int selAi = 2;
    bool selDrama = true;
    const string SettingsKey = "powerchess.settings.v1";
    GameSession S = null!;

    record PerkBtn(PowerupKind Kind, ActionKind Action, string Label, string Tip);

    static readonly PerkBtn[] ChipKinds =
    {
        new(PowerupKind.Steal, ActionKind.Steal, "Steal", "Steals"),
        new(PowerupKind.Stun, ActionKind.Stun, "Stun", "Stuns"),
        new(PowerupKind.Boulder, ActionKind.PlaceBoulder, "Boulder", "Boulders"),
        new(PowerupKind.Swap, ActionKind.Swap, "Swap", "Swaps: trade two of your pieces"),
        new(PowerupKind.Reroll, ActionKind.ClearBoulder, "Smash boulder", "Rerolls: re-draw a powerup you find, or smash a boulder"),
        new(PowerupKind.Rewind, ActionKind.Move, "Rewind", "Rewinds: take back your last turn"),
    };

    static readonly PerkBtn[] PerkButtons =
    {
        new(PowerupKind.Steal, ActionKind.Steal, "Steal", "Steals"),
        new(PowerupKind.Stun, ActionKind.Stun, "Stun", "Stuns"),
        new(PowerupKind.Boulder, ActionKind.PlaceBoulder, "Boulder", "Boulders"),
        new(PowerupKind.Swap, ActionKind.Swap, "Swap", "Swaps: trade two of your pieces"),
        new(PowerupKind.Reroll, ActionKind.ClearBoulder, "Smash boulder", "Rerolls: re-draw a powerup you find, or smash a boulder"),
    };

    /// <summary>The side whose inventory the action bar shows (the human, or whoever is to move in 2-player mode).</summary>
    Side ActiveSide => S.VsAi ? Side.White : S.Turn;

    const string SaveKey = "powerchess.save.v1";
    const string TutKey = "powerchess.tutorials.v1";
    const string PlayedKey = "powerchess.played.v1";
    bool debugOptions;
    readonly TutorialState tut = new();

    protected override async Task OnInitializedAsync()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        opt = GameOptions.FromQuery(uri.Query);
        urlSeed = uri.Query.Contains("seed=", StringComparison.OrdinalIgnoreCase);
        // Any explicit scenario option (seed, fen, perks, ...) means "start exactly this": no resuming, no saving.
        showDebug = uri.Query.Contains("debug=1", StringComparison.OrdinalIgnoreCase);
        debugOptions = new[] { "seed=", "fen=", "pairs=", "spawn=", "rerolls=", "only=", "perks=", "buffs=", "mystery=", "demo=", "training=", "mode=", "hidden=", "reveal=", "portal=", "portals=", "drama=", "level=", "preset=", "freq=", "custom=" }
            .Any(k => uri.Query.Contains(k, StringComparison.OrdinalIgnoreCase));

        // A session must exist for the first render. It does not save yet, so it cannot overwrite the stored game
        // before we have read it.
        if (debugOptions && !opt.TutorialsExplicit) opt.Tutorials = false;
        StartNew(persist: false);

        string? saved = null, played = null, tutText = null, settingsText = null, profileText = null;
        try
        {
            tutText = await JS.InvokeAsync<string?>("localStorage.getItem", TutKey);
            profileText = await JS.InvokeAsync<string?>("localStorage.getItem", ProfileKey);
            if (!debugOptions)
            {
                saved = await JS.InvokeAsync<string?>("localStorage.getItem", SaveKey);
                played = await JS.InvokeAsync<string?>("localStorage.getItem", PlayedKey);
                settingsText = await JS.InvokeAsync<string?>("localStorage.getItem", SettingsKey);
            }
        }
        catch { /* storage unavailable: just play */ }

        profile = ProfileCodec.Decode(profileText);
        await RefreshToday();
        if (!debugOptions) opt.Level = profile.Level;
        var stored = TutorialState.Parse(tutText);
        tut.Off = stored.Off;
        tut.Seen.Clear();
        foreach (var k in stored.Seen) tut.Seen.Add(k);

        if (opt.Demo is PowerupKind demo) S.ShowTutorial(demo);
        if (debugOptions) return;

        // Remembered choices from the New game sheet (mode and opponent).
        bool haveSettings = false;
        var sp = (settingsText ?? "").Split(':');
        if (sp.Length >= 2 && sp.Length <= 6 && int.TryParse(sp[1], out var savedAi) && savedAi >= 0 && savedAi <= 5)
        {
            if (sp.Length >= 3) opt.Drama = sp[2] != "0";
            if (sp.Length >= 5)
            {
                opt.Preset = sp[3] == Presets.Custom || Presets.Find(sp[3]) != null ? sp[3] : Presets.Classic;
                if (int.TryParse(sp[4], out var sf)) opt.Freq = (Frequency)Math.Clamp(sf, 0, 3);
            }
            if (sp.Length == 6 && sp[5].Length > 0) opt.Custom = sp[5];
            opt.Mode = sp[0] == "mystery" ? SquareMode.Mystery : SquareMode.Revealed;
            opt.Ai = savedAi;
            haveSettings = true;
        }

        bool restored = !string.IsNullOrEmpty(saved) && S.Restore(saved);
        if (!restored)
        {
            bool firstEver = played == null && !tut.Off && opt.Tutorials;
            opt.Training = firstEver; // someone's very first game starts on the small training board
            if (firstEver || haveSettings) StartNew(persist: false);
            opt.Training = false;
        }
        EnablePersist();
        try { await JS.InvokeVoidAsync("localStorage.setItem", PlayedKey, "1"); } catch { }
        if (restored) await S.ResumeAi();
    }

    void StartTraining()
    {
        showHelp = false;
        opt.Training = true;
        StartNew();
        opt.Training = false;
    }

    void ResetTutorials()
    {
        S.ResetTutorials();
    }

    static string TutorialTitle(PowerupKind k) => PowerupInfo.IsTransform(k) ? "Transform squares" : Names.Name(k);

    static string TutorialText(PowerupKind k) => PowerupInfo.IsTransform(k)
        ? "The piece that opens one changes into another piece on the spot. Never a king."
        : Names.Desc(k);

    void StartNew() => StartNew(persist: true);

    void StartNew(bool persist)
    {
        if (S != null) { S.Changed = null; S.Sfx = null; S.Persist = null; }
        if (!urlSeed) opt.Seed = (ulong)DateTime.UtcNow.Ticks;
        if (!debugOptions) opt.Level = profile.Level;
        S = new GameSession(opt, tut);
        WireSession();
        reward = null;
        if (persist && !debugOptions) EnablePersist();
    }

    void EnablePersist()
    {
        S.Persist = text => { _ = PersistAsync(text); };
        S.Persist(S.GameOver ? null : S.SaveString());
    }

    async Task SetItemAsync(string key, string value)
    {
        try { await JS.InvokeVoidAsync("localStorage.setItem", key, value); } catch { }
    }

    async Task PersistAsync(string? text)
    {
        try
        {
            if (text == null) await JS.InvokeVoidAsync("localStorage.removeItem", SaveKey);
            else await JS.InvokeVoidAsync("localStorage.setItem", SaveKey, text);
        }
        catch { /* private mode or quota: resuming just will not work */ }
    }

    async Task PlaySfx(string name)
    {
        try { await JS.InvokeVoidAsync("pcfx.play", name); } catch { }
    }

    async Task ToggleMute()
    {
        muted = !muted;
        try { await JS.InvokeVoidAsync("pcfx.setMuted", muted); } catch { }
    }

    void OpenNew()
    {
        selMode = opt.Mode;
        selAi = opt.Ai;
        selDrama = opt.Drama;
        selPreset = Presets.Available(opt.Preset, EffectiveLevel) ? opt.Preset : Presets.Classic;
        selFreq = Presets.FrequencyAvailable(EffectiveLevel) ? opt.Freq : Frequency.Normal;
        selCustom = opt.Custom;
        showNew = true;
    }

    void StartFromSheet()
    {
        opt.Mode = selMode;
        opt.Ai = selAi;
        opt.Drama = selDrama;
        opt.Preset = selPreset;
        opt.Freq = selFreq;
        opt.Custom = selCustom;
        showNew = false;
        _ = SetItemAsync(SettingsKey, (selMode == SquareMode.Revealed ? "revealed" : "mystery") + ":" + selAi + ":" + (selDrama ? "1" : "0") + ":" + selPreset + ":" + (int)selFreq + ":" + selCustom);
        StartNew();
    }

    string RulesLabel => S.Puzzle != null ? "" : Presets.Label(opt.Preset, opt.Freq, EffectiveLevel);

    string selPreset = Presets.Classic;
    Frequency selFreq = Frequency.Normal;
    string selCustom = Presets.DefaultCustom();
    bool showCustom;

    static IEnumerable<(string id, string name, string blurb, int level)> PresetChoices()
    {
        yield return (Presets.Classic, "Standard", "The normal powerup mix.", 1);
        foreach (var p in Presets.All) yield return (p.Id, p.Name, p.Blurb, p.UnlockLevel);
        yield return (Presets.Custom, "Custom", "Choose which powerups appear and how often.", Presets.CustomLevel);
    }

    static string PresetBlurb(string id) => Presets.Find(id)?.Blurb ?? "Choose which powerups appear and how often.";

    static string Seg(bool on) => "seg-btn" + (on ? " on" : "");

    /// <summary>"fireball", "hidden" or "" for what a powerup square shows, for styling and tests.</summary>
    string ContentName(int sq)
    {
        if (!S.View.Mystery[sq]) return S.View.Portal[sq] ? "portal" : "";
        var k = (PowerupKind)S.View.Content[sq];
        return k == PowerupKind.None ? "hidden" : k.ToString().ToLowerInvariant();
    }

    public void Dispose()
    {
        if (S != null) { S.Changed = null; S.Sfx = null; S.Persist = null; }
    }

    // ---------- presentation helpers ----------

    string TileClass(int sq)
    {
        bool light = (Sq.File(sq) + Sq.Rank(sq)) % 2 == 1;
        var c = "sq " + (light ? "light" : "dark");
        var cell = S.View.Cells[sq];
        if (S.View.Mystery[sq]) c += " mystery powerup " + Names.SquareClass((PowerupKind)S.View.Content[sq]);
        else if (S.View.Portal[sq]) c += " portal powerup pu-portal";
        if (S.View.Boulders[sq]) c += " rock";
        if (sq == S.ViewLastFrom || sq == S.ViewLastTo) c += " last";
        if (sq == S.Selected) c += " selected";
        if (S.Targets.Contains(sq))
        {
            bool enemy = !cell.IsEmpty && cell.Side != S.Turn;
            c += S.Mode == InputMode.Armed || S.Mode == InputMode.FireAim
                ? " aim"
                : enemy ? " target cap" : " target";
        }
        if (S.Doomed.Contains(sq)) c += " doomed";
        if (S.Spared.Contains(sq)) c += " spared";
        if (S.BlastArea.Contains(sq)) c += " blast";
        if (S.InCheck && !S.Reviewing && cell.Type == PieceType.King && cell.Side == S.Turn && !S.GameOver) c += " check";
        return c;
    }

    RenderFragment InvChips(Side side) => @<text>
        @foreach (var k in ChipKinds)
        {
            int n = S.Perk(side, k.Kind);
            <span class="chip @(n == 0 ? "zero" : "")" title="@k.Tip" data-chip="@k.Kind.ToString().ToLowerInvariant()">@Icons.Svg(Names.Icon(k.Kind))<b>@n</b></span>
        }
    </text>;

    string InspectTitle(Piece p)
    {
        string owner = S.VsAi ? (p.Side == Side.White ? "Your" : "Rival") : (p.Side == Side.White ? "White" : "Black");
        return owner + " " + p.Type;
    }

    string DrawText => S.ResultReason switch
    {
        "Stalemate" => "The player to move has no legal move and is not in check.",
        "Only kings left" => "Nothing is left to checkmate with.",
        "50-move rule" => "Fifty moves without a capture or pawn move.",
        "Move limit reached" => "The game ran out of moves.",
        _ => "Nobody could finish it.",
    };

    string ResultClass => S.Result == GameResult.Draw ? "draw" : (S.VsAi && S.Winner() == Side.Black ? "lose" : "win");

    string ResultTitle => S.Result == GameResult.Draw
        ? "DRAW"
        : S.VsAi ? (S.Winner() == Side.White ? "VICTORY" : "DEFEATED")
        : (S.Winner() == Side.White ? "WHITE WINS" : "BLACK WINS");

    string ResultText => S.Result == GameResult.Draw
        ? DrawText
        : S.VsAi ? (S.Winner() == Side.White ? "Nice. Checkmate!" : "The rival got you this time.")
        : "Checkmate.";
}
